---
import type { HistoryEntry } from "@/data/history";

interface Props {
  entries: HistoryEntry[];
}
const { entries } = Astro.props;

// Тег категории — честно по содержанию записи: «экспонат» только там, где
// это буквально так (бланк меню 1979 года прямо назван хранимым экспонатом
// в src/data/history.ts), остальное — «запись хроники», без выдумывания
// несуществующих музейных предметов (в референсе был берестяной туесок —
// такого подтверждённого артефакта у заведения нет, поэтому не используем).
function tagFor(entry: HistoryEntry): string {
  return entry.body.includes("экспонат") ? "документ · экспонат" : "запись хроники";
}
---

<div class="relative -mx-5 md:-mx-8">
  <div class="border-y border-brass-on-dark/25 bg-ink/70 py-10 backdrop-blur-md md:py-14">
    <div class="mb-6 flex items-center justify-between px-5 md:px-8">
      <h2 class="font-mono text-xs tracking-wide text-paper-raised/70 uppercase">Моменты истории</h2>
      <div class="flex gap-2">
        <button
          type="button"
          id="hc-prev"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-brass-on-dark/50 text-paper-raised transition-colors hover:bg-brass-on-dark hover:text-ink"
          aria-label="Предыдущий момент"
        >
          <svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M7 1L1 7L7 13" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
        <button
          type="button"
          id="hc-next"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-brass-on-dark/50 text-paper-raised transition-colors hover:bg-brass-on-dark hover:text-ink"
          aria-label="Следующий момент"
        >
          <svg width="8" height="14" viewBox="0 0 8 14" fill="none" aria-hidden="true"><path d="M1 1L7 7L1 13" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
      </div>
    </div>

    <div id="hc-track" class="flex snap-x snap-mandatory gap-5 overflow-x-auto px-5 pb-2 [scrollbar-width:none] md:px-8 [&::-webkit-scrollbar]:hidden">
      {entries.map((entry) => (
        <article class="plaque w-[82vw] shrink-0 snap-start border-brass-on-dark/30 bg-ink/60 p-6 sm:w-[380px] md:p-8" data-reveal>
          <p class="font-mono text-[11px] tracking-wide text-brass-on-dark uppercase">{tagFor(entry)}</p>
          <p class="mt-3 font-mono text-2xl font-semibold text-paper-raised">{entry.year}</p>
          <h3 class="mt-2 font-display text-lg font-semibold text-paper-raised md:text-xl">{entry.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-paper-raised/80">{entry.body}</p>
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  const track = document.getElementById("hc-track");
  const prev = document.getElementById("hc-prev");
  const next = document.getElementById("hc-next");
  if (track && prev && next) {
    const scrollByCard = (dir: 1 | -1) => {
      const card = track.querySelector("article");
      const step = card ? card.getBoundingClientRect().width + 20 : 320;
      track.scrollBy({ left: dir * step, behavior: "smooth" });
    };
    prev.addEventListener("click", () => scrollByCard(-1));
    next.addEventListener("click", () => scrollByCard(1));
  }
</script>
