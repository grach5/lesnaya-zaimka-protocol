---
import { CONTACTS } from "@/data/contacts";
import { withBase } from "@/lib/url";
import { NAV_GROUPS } from "@/data/nav";
import { getContent, localizedHref, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
}
const { locale = "ru" } = Astro.props;
const t = getContent(locale);

function resolveHref(href: string, external?: boolean) {
  if (external) return href;
  if (href.endsWith(".pdf")) return withBase(href);
  return localizedHref(href, locale);
}

const navGroupLabels = [t.ui.nav.restaurantGroup, t.ui.nav.hotelGroup, t.ui.nav.banquetGroup];
const navGroupItemLabels = [
  [t.ui.nav.history, t.ui.nav.mainMenu, t.ui.nav.kidsMenuPdf, t.ui.nav.barMenuPdf, t.ui.nav.interior],
  [t.ui.nav.bookRoom, t.ui.nav.sauna, t.ui.nav.hotelServices],
  [t.ui.nav.hallRental, t.ui.nav.banquetMenuPdf, t.ui.nav.eventsCatering],
];
---

<!-- Футер по рукописной схеме клиента: разделы комплекса колонками
     (Ресторан / Отель / Банкетный комплекс), автомойка и контакты отдельно.
     relative — обязателен: TimberBackdrop (position:fixed) красится в том же
     слое стекинга, что и любой ПОЗИЦИОНИРОВАННЫЙ потомок body (см. main
     с его же relative); без этого статичный (position:static) <footer>
     красится РАНЬШЕ фикс-фона и оказывается полностью перекрыт им — сам
     футер и его контент при этом абсолютно рабочие, просто невидимые. -->
<footer class="relative border-t-2 border-[var(--color-gold)]/50 bg-[var(--color-velvet-deep)] text-paper-sunk">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-1">
        <!-- По прямой правке клиента: тёмно-красный логотип на тёмном фоне
             футера «сливается» — здесь (только в футере) перекрашиваем в
             золотой через CSS-маску по альфа-каналу самого файла, а не
             трогаем реальный PNG клиента (он остаётся неизменным везде
             на светлом фоне, где и задумывался). -->
        <span
          role="img"
          aria-label={CONTACTS.name}
          class="block h-10 bg-[var(--color-gold)]"
          style={`aspect-ratio:944/268; -webkit-mask-image:url(${withBase("/img/brand/logo.png")}); mask-image:url(${withBase("/img/brand/logo.png")}); -webkit-mask-size:contain; mask-size:contain; -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat; -webkit-mask-position:left center; mask-position:left center;`}
        ></span>
        <p class="mt-3 max-w-[30ch] text-sm text-paper-sunk/80">
          {t.ui.footer.tagline}
        </p>
      </div>

      {NAV_GROUPS.map((group, gi) => (
        <div>
          <p class="font-mono text-xs uppercase tracking-wide text-paper-sunk/60">{navGroupLabels[gi]}</p>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            {group.items.map((item, ii) => (
              <li>
                <a href={resolveHref(item.href, item.external)} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener" : undefined}>
                  {navGroupItemLabels[gi][ii]}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-paper-sunk/60">{t.ui.footer.carwashGroup}</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li><a href={localizedHref("/carwash/", locale)}>{t.ui.footer.carwashAbout}</a></li>
        </ul>

        <p class="mt-6 font-mono text-xs uppercase tracking-wide text-paper-sunk/60">{t.ui.footer.moreGroup}</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li><a href={localizedHref("/reviews/", locale)}>{t.ui.nav.reviews}</a></li>
          <li><a href={localizedHref("/gallery/", locale)}>{t.ui.nav.gallery}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 grid gap-10 border-t border-paper-sunk/15 pt-10 sm:grid-cols-2">
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-paper-sunk/60">{t.ui.footer.contactsGroup}</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li><a href={CONTACTS.phoneTableHref}>{CONTACTS.phoneTable}</a> — {t.ui.footer.bookTablePhoneNote}</li>
          <li><a href={CONTACTS.phoneEventsHref}>{CONTACTS.phoneEvents}</a> — {t.ui.footer.banquetDeptNote}</li>
          <li><a href={CONTACTS.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
          <li>{CONTACTS.address}</li>
          <li>{CONTACTS.hours}</li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-paper-sunk/60">{t.ui.footer.nearbyGroup}</p>
        <p class="mt-3 text-sm">
          <a href={CONTACTS.hotel.url} target="_blank" rel="noopener" class="text-[var(--color-gold)] underline underline-offset-4">
            {t.ui.footer.hotelAndSauna} {CONTACTS.hotel.name} →
          </a>
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-paper-sunk/15 pt-6 font-mono text-xs text-paper-sunk/70">
      <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>{t.ui.footer.copyright}</span>
        <a href={localizedHref("/privacy/", locale)} class="underline underline-offset-2 hover:text-[var(--color-gold)]">{t.ui.footer.privacyPolicy}</a>
      </span>
      <button
        id="motion-toggle"
        type="button"
        data-on-label={t.ui.footer.animationsOn}
        data-off-label={t.ui.footer.animationsOff}
        class="border border-paper-sunk/30 px-3 py-1.5 text-paper-sunk/80 transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
        aria-pressed="true"
      >
        {t.ui.footer.animationsLabel} <span id="motion-toggle-label">{t.ui.footer.animationsOn}</span>
      </button>
    </div>
  </div>
</footer>

<script>
  import { setMotionPreference } from "@/lib/motion";

  const btn = document.getElementById("motion-toggle");
  const label = document.getElementById("motion-toggle-label");
  const current = document.documentElement.dataset.motion !== "off";
  const onLabel = btn?.dataset.onLabel ?? "on";
  const offLabel = btn?.dataset.offLabel ?? "off";
  if (label) label.textContent = current ? onLabel : offLabel;
  btn?.setAttribute("aria-pressed", String(current));

  btn?.addEventListener("click", () => {
    const next = document.documentElement.dataset.motion === "off";
    setMotionPreference(next);
  });
</script>
