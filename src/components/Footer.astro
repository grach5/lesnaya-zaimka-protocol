---
import { CONTACTS } from "@/data/contacts";
import { withBase } from "@/lib/url";
import { NAV_GROUPS } from "@/data/nav";

function resolveHref(href: string, external?: boolean) {
  return external ? href : withBase(href);
}
---

<!-- Футер по рукописной схеме клиента: разделы комплекса колонками
     (Ресторан / Отель / Банкетный комплекс), автомойка и контакты отдельно.
     relative — обязателен: TimberBackdrop (position:fixed) красится в том же
     слое стекинга, что и любой ПОЗИЦИОНИРОВАННЫЙ потомок body (см. main
     с его же relative); без этого статичный (position:static) <footer>
     красится РАНЬШЕ фикс-фона и оказывается полностью перекрыт им — сам
     футер и его контент при этом абсолютно рабочие, просто невидимые. -->
<footer class="relative border-t-2 border-[var(--color-gold)]/50 bg-[var(--color-velvet-deep)] text-paper-sunk">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-1">
        <img src={withBase("/img/brand/logo.png")} alt={CONTACTS.name} class="h-10 w-auto" />
        <p class="mt-3 max-w-[30ch] text-sm text-paper-sunk/80">
          Ресторанный комплекс с 1974 года. Бревенчатый терем на въезде во Владивосток.
        </p>
      </div>

      {NAV_GROUPS.map((group) => (
        <div>
          <p class="font-mono text-xs uppercase tracking-wide text-paper-sunk/60">{group.label}</p>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            {group.items.map((item) => (
              <li>
                <a href={resolveHref(item.href, item.external)} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener" : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-paper-sunk/60">Автомойка</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li><a href={withBase("/carwash/")}>О разделе</a></li>
        </ul>

        <p class="mt-6 font-mono text-xs uppercase tracking-wide text-paper-sunk/60">Ещё</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li><a href={withBase("/reviews/")}>Отзывы</a></li>
          <li><a href={withBase("/gallery/")}>Галерея</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 grid gap-10 border-t border-paper-sunk/15 pt-10 sm:grid-cols-2">
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-paper-sunk/60">Контакты</p>
        <ul class="mt-3 flex flex-col gap-2 text-sm">
          <li><a href={CONTACTS.phoneTableHref}>{CONTACTS.phoneTable}</a> — бронь столов</li>
          <li><a href={CONTACTS.phoneEventsHref}>{CONTACTS.phoneEvents}</a> — банкетный отдел</li>
          <li><a href={CONTACTS.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
          <li>{CONTACTS.address}</li>
          <li>{CONTACTS.hours}</li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-paper-sunk/60">Рядом</p>
        <p class="mt-3 text-sm">
          <a href={CONTACTS.hotel.url} target="_blank" rel="noopener" class="text-[var(--color-gold)] underline underline-offset-4">
            Отель и сауна {CONTACTS.hotel.name} →
          </a>
        </p>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-paper-sunk/15 pt-6 font-mono text-xs text-paper-sunk/70">
      <span>© 1974 — 2026 Ресторан «{CONTACTS.name}»</span>
      <button
        id="motion-toggle"
        type="button"
        class="border border-paper-sunk/30 px-3 py-1.5 text-paper-sunk/80 transition-colors hover:border-[var(--color-gold)] hover:text-[var(--color-gold)]"
        aria-pressed="true"
      >
        Анимации: <span id="motion-toggle-label">вкл</span>
      </button>
    </div>
  </div>
</footer>

<script>
  import { setMotionPreference } from "@/lib/motion";

  const btn = document.getElementById("motion-toggle");
  const label = document.getElementById("motion-toggle-label");
  const current = document.documentElement.dataset.motion !== "off";
  if (label) label.textContent = current ? "вкл" : "выкл";
  btn?.setAttribute("aria-pressed", String(current));

  btn?.addEventListener("click", () => {
    const next = document.documentElement.dataset.motion === "off";
    setMotionPreference(next);
  });
</script>
