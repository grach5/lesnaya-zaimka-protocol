---
import { CONTACTS } from "@/data/contacts";
import { ZAIMKA_MENU } from "@/data/menu";
import { getContent, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
}
const { locale = "ru" } = Astro.props;
const t = getContent(locale);

// Корзина/сообщение в WhatsApp хранят и отправляют РЕАЛЬНОЕ русское название
// блюда (его понимает кухня, независимо от языка гостя) — но гостю на не-RU
// версии сайта в самой панели корзины нужно видеть перевод, а не русский
// текст. Карта "русское название -> переведённое" строится по индексу
// (тот же порядок категорий/блюд, что и в ZAIMKA_MENU) и уходит в data-атрибут
// для клиентского скрипта, который сам ничего не знает о текущей локали.
const nameMap: Record<string, string> = {};
if (locale !== "ru") {
  ZAIMKA_MENU.categories.forEach((cat, ci) => {
    cat.items.forEach((item, ii) => {
      const translated = t.data.menuCategories[ci]?.items[ii];
      if (translated) nameMap[item.name] = translated;
    });
  });
}
---

<!-- Панель предзаказа — фикс поверх всего сайта (как модалка), открывается
     кнопкой корзины в шапке. Реальная отправка — через WhatsApp deep-link на
     номер ресторана (CONTACTS.whatsapp), без бэкенда/оплаты — см. src/lib/cart.ts. -->
<div id="cart-overlay" class="fixed inset-0 z-[90] hidden bg-ink/60 backdrop-blur-sm" aria-hidden="true"></div>
<aside
  id="cart-drawer"
  class="fixed inset-y-0 right-0 z-[95] flex hidden w-full max-w-md translate-x-full flex-col bg-paper-raised text-ink shadow-2xl transition-transform duration-300 ease-out"
  role="dialog"
  aria-modal="true"
  aria-label={t.ui.cart.title}
  data-fmt-hall={t.ui.cart.formatHall}
  data-fmt-takeaway={t.ui.cart.formatTakeaway}
  data-fmt-delivery={t.ui.cart.formatDelivery}
  data-greeting={t.ui.cart.whatsappGreeting.replace("{name}", CONTACTS.name)}
  data-total-line={t.ui.cart.totalLine}
  data-fmt-label={t.ui.cart.formatLabel}
  data-dec-aria={t.ui.cart.decreaseAria}
  data-inc-aria={t.ui.cart.increaseAria}
  data-name-map={JSON.stringify(nameMap)}
>
  <div class="flex items-center justify-between border-b border-line px-5 py-4">
    <p class="font-display text-lg font-semibold text-ink">{t.ui.cart.title}</p>
    <button id="cart-close" type="button" aria-label={t.ui.cart.closeAria} class="flex h-9 w-9 items-center justify-center text-ink-soft hover:text-ink">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1 1L15 15M15 1L1 15" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
  </div>

  <div id="cart-empty" class="flex flex-1 flex-col items-center justify-center gap-3 px-8 text-center">
    <p class="text-ink-soft">{t.ui.cart.empty}</p>
    <a href="#" data-cart-menu-link class="font-mono text-[13px] text-ink underline decoration-line underline-offset-4 hover:decoration-brass">{t.ui.cart.openMenu}</a>
  </div>

  <div id="cart-body" class="hidden flex-1 flex-col overflow-hidden">
    <div id="cart-items" class="flex-1 divide-y divide-line overflow-y-auto px-5"></div>

    <div class="border-t border-line px-5 py-4">
      <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.ui.cart.formatLabel}</p>
      <div class="mt-2 flex gap-2">
        <button type="button" data-format="hall" class="cart-format-btn flex-1 border border-ink px-2 py-2 font-mono text-[12px]" aria-pressed="true">{t.ui.cart.formatHall}</button>
        <button type="button" data-format="takeaway" class="cart-format-btn flex-1 border border-line px-2 py-2 font-mono text-[12px] text-ink-soft" aria-pressed="false">{t.ui.cart.formatTakeaway}</button>
        <button type="button" data-format="delivery" class="cart-format-btn flex-1 border border-line px-2 py-2 font-mono text-[12px] text-ink-soft" aria-pressed="false">{t.ui.cart.formatDelivery}</button>
      </div>
    </div>

    <div class="border-t border-line px-5 py-4">
      <div class="flex items-center justify-between">
        <span class="font-mono text-sm text-ink-soft">{t.ui.cart.total}</span>
        <span id="cart-total" class="font-mono text-xl font-semibold text-ink">0 ₽</span>
      </div>
      <a
        id="cart-submit"
        href="#"
        target="_blank"
        rel="noopener"
        class="plaque mt-4 flex items-center justify-center gap-2 bg-ink px-5 py-3 font-mono text-[13px] tracking-wide text-paper-raised transition-colors hover:bg-brass"
      >
        {t.ui.cart.submit}
      </a>
      <p class="mt-3 text-center text-xs text-ink-faint">
        {t.ui.cart.notPaymentNote.replace("{name}", CONTACTS.name)}
      </p>
    </div>
  </div>
</aside>

<script>
  import { getCart, setQty, cartCount, cartTotal, onCartChange, type CartItem } from "@/lib/cart";
  import { CONTACTS } from "@/data/contacts";
  import { withBase } from "@/lib/url";
  import { getCurrentLocalePath, getCurrentLocale } from "@/lib/currentLocale";
  import { sendToCrm } from "@/lib/crm";

  const overlay = document.getElementById("cart-overlay");
  const drawer = document.getElementById("cart-drawer");
  const closeBtn = document.getElementById("cart-close");
  const emptyEl = document.getElementById("cart-empty");
  const bodyEl = document.getElementById("cart-body");
  const itemsEl = document.getElementById("cart-items");
  const totalEl = document.getElementById("cart-total");
  const submitEl = document.getElementById("cart-submit") as HTMLAnchorElement | null;
  const menuLink = document.querySelector<HTMLAnchorElement>("[data-cart-menu-link]");
  if (menuLink) menuLink.href = withBase(getCurrentLocalePath("/menu/"));

  const fmtLabels = {
    hall: drawer?.dataset.fmtHall ?? "",
    takeaway: drawer?.dataset.fmtTakeaway ?? "",
    delivery: drawer?.dataset.fmtDelivery ?? "",
  };
  const greetingTpl = drawer?.dataset.greeting ?? "";
  const totalLine = drawer?.dataset.totalLine ?? "";
  let nameMap: Record<string, string> = {};
  try {
    nameMap = JSON.parse(drawer?.dataset.nameMap ?? "{}");
  } catch {
    nameMap = {};
  }
  const displayName = (ruName: string) => nameMap[ruName] ?? ruName;
  const decAria = drawer?.dataset.decAria ?? "";
  const incAria = drawer?.dataset.incAria ?? "";

  let format: "hall" | "takeaway" | "delivery" = "hall";

  // Найдено реальным аудитом: незакрытый таймер close() мог сработать ПОСЛЕ
  // быстрого повторного open() и скрыть только что открытую панель, оставив
  // body.overflow="hidden" навсегда (страница переставала скроллиться).
  // Единственная переменная под оба таймера + явный clearTimeout перед стартом
  // нового цикла устраняет гонку.
  let transitionTimer: number | null = null;
  let lastFocused: HTMLElement | null = null;

  function setBackgroundInert(on: boolean) {
    // Модалка была role="dialog" aria-modal="true" без реальной изоляции —
    // клавиатурный пользователь мог провалиться в контент под панелью.
    // inert одновременно прячет фон от скринридера и убирает его из порядка
    // Tab — простой и надёжный аналог ручной focus-trap.
    document.querySelector("header")?.toggleAttribute("inert", on);
    document.querySelector("main")?.toggleAttribute("inert", on);
    document.querySelector("footer")?.toggleAttribute("inert", on);
  }

  function open() {
    if (transitionTimer) window.clearTimeout(transitionTimer);
    lastFocused = document.activeElement as HTMLElement | null;
    overlay?.classList.remove("hidden");
    drawer?.classList.remove("hidden");
    setBackgroundInert(true);
    // setTimeout, а не requestAnimationFrame: нужно только дать браузеру один тик,
    // чтобы снятие display:none (через classList "hidden") успело примениться до
    // снятия transform — иначе transition схлопывается в мгновенный прыжок.
    // rAF для этого не подходит: он привязан к циклу компоновки/отрисовки и не
    // гарантированно срабатывает в фоновой/неактивной вкладке — а именно так вело
    // себя на реальном мобильном тесте (панель оставалась за экраном).
    transitionTimer = window.setTimeout(() => {
      drawer?.classList.remove("translate-x-full");
      closeBtn?.focus();
    }, 10);
    document.body.style.overflow = "hidden";
  }

  function close() {
    if (transitionTimer) window.clearTimeout(transitionTimer);
    drawer?.classList.add("translate-x-full");
    document.body.style.overflow = "";
    setBackgroundInert(false);
    transitionTimer = window.setTimeout(() => {
      overlay?.classList.add("hidden");
      drawer?.classList.add("hidden");
    }, 300);
    lastFocused?.focus();
  }

  overlay?.addEventListener("click", close);
  closeBtn?.addEventListener("click", close);
  window.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || drawer?.classList.contains("hidden")) return;
    close();
  });
  drawer?.addEventListener("keydown", (e) => {
    // inert на фоне уже не даёт табу выйти за пределы панели, но без хотя бы
    // одного цикла оборачивания Tab с последнего фокусируемого элемента может
    // уйти в адресную строку браузера — простой цикл внутри самой панели.
    if (e.key !== "Tab") return;
    const focusable = drawer.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])'
    );
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  document.querySelectorAll<HTMLButtonElement>(".cart-format-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      format = btn.dataset.format === "takeaway" ? "takeaway" : btn.dataset.format === "delivery" ? "delivery" : "hall";
      document.querySelectorAll<HTMLButtonElement>(".cart-format-btn").forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-pressed", String(active));
        b.classList.toggle("border-ink", active);
        b.classList.toggle("border-line", !active);
        b.classList.toggle("text-ink-soft", !active);
      });
      buildMessage();
    });
  });

  function buildMessage(): void {
    const items = getCart();
    const total = cartTotal(items);
    if (!submitEl) return;
    const lines = items.map((i) => `${i.qty} × ${i.name} — ${(i.price * i.qty).toLocaleString("ru-RU")} ₽`);
    const formatLabel = fmtLabels[format];
    const fmtLine = `${drawer?.dataset.fmtLabel ?? ""}: ${formatLabel}`;
    const text = [
      greetingTpl,
      "",
      ...lines,
      "",
      fmtLine,
      `${totalLine} ${total.toLocaleString("ru-RU")} ₽`,
    ].join("\n");
    submitEl.href = `${CONTACTS.whatsapp}?text=${encodeURIComponent(text)}`;
  }

  submitEl?.addEventListener("click", () => {
    const items = getCart();
    if (!items.length) return;
    sendToCrm({
      source: "cart",
      items: items.map((i) => ({ name: i.name, price: i.price, qty: i.qty })),
      total: cartTotal(items),
      locale: getCurrentLocale(),
      pageUrl: window.location.href,
    });
  });

  function render(): void {
    const items = getCart();
    if (!items.length) {
      emptyEl?.classList.remove("hidden");
      bodyEl?.classList.add("hidden");
      bodyEl?.classList.remove("flex");
      return;
    }
    emptyEl?.classList.add("hidden");
    bodyEl?.classList.remove("hidden");
    bodyEl?.classList.add("flex");

    if (itemsEl) {
      itemsEl.innerHTML = "";
      items.forEach((item: CartItem) => {
        const row = document.createElement("div");
        row.className = "flex items-center justify-between gap-3 py-4";
        const shown = displayName(item.name);
        row.innerHTML = `
          <div class="min-w-0">
            <p class="truncate text-sm text-ink">${shown}</p>
            <p class="font-mono text-xs text-ink-faint">${item.price.toLocaleString("ru-RU")} ₽</p>
          </div>
          <div class="flex shrink-0 items-center gap-1.5">
            <button type="button" data-action="dec" aria-label="${decAria}: ${shown}" class="flex h-10 w-10 items-center justify-center border border-line text-ink-soft hover:border-ink hover:text-ink">−</button>
            <span class="w-5 text-center font-mono text-sm">${item.qty}</span>
            <button type="button" data-action="inc" aria-label="${incAria}: ${shown}" class="flex h-10 w-10 items-center justify-center border border-line text-ink-soft hover:border-ink hover:text-ink">+</button>
          </div>
        `;
        row.querySelector('[data-action="dec"]')?.addEventListener("click", () => setQty(item.name, item.qty - 1));
        row.querySelector('[data-action="inc"]')?.addEventListener("click", () => setQty(item.name, item.qty + 1));
        itemsEl.appendChild(row);
      });
    }

    if (totalEl) totalEl.textContent = `${cartTotal(items).toLocaleString("ru-RU")} ₽`;
    buildMessage();
  }

  onCartChange(render);
  render();

  document.querySelectorAll<HTMLElement>("[data-cart-open]").forEach((btn) => btn.addEventListener("click", open));

  function updateBadges() {
    const n = cartCount();
    document.querySelectorAll<HTMLElement>("[data-cart-badge]").forEach((el) => {
      el.textContent = String(n);
      el.classList.toggle("hidden", n === 0);
    });
  }
  onCartChange(updateBadges);
  updateBadges();
</script>
