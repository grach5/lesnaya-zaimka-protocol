---
import { withBase } from "@/lib/url";
import { NAV_GROUPS, NAV_SINGLE } from "@/data/nav";
import { getContent, localizedHref, LOCALES, LOCALE_LABELS, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
  /** Путь текущей страницы без base/локали (напр. "/menu/") — для языкового переключателя. */
  path?: string;
}
const { locale = "ru", path = "/" } = Astro.props;
const t = getContent(locale);

const contactsHref = localizedHref("/contacts/", locale);
const eventsFormHref = localizedHref("/events/", locale) + "#form";

// Статические PDF и внешние ссылки (отель-партнёр) не зависят от локали сайта —
// у PDF нет переведённой версии (реальный документ клиента), внешний домен свой.
function resolveHref(href: string, external?: boolean) {
  if (external) return href;
  if (href.endsWith(".pdf")) return withBase(href);
  return localizedHref(href, locale);
}

// Подписи меню переведены по фиксированному порядку пунктов в nav.ts —
// сама структура/href остаются едиными для всех языков.
// Короткие подписи — полные («Гостиница Villa ArtE», «Банкетный комплекс») не
// помещаются в один ряд шапки на десктопе вместе с остальными пунктами и двумя
// CTA-кнопками, из-за чего текст переносился и ломал вёрстку. Полные версии
// остаются в футере (Footer.astro), где места достаточно.
const navGroupLabels = [t.ui.nav.restaurantGroup, t.ui.nav.hotelGroupShort, t.ui.nav.banquetGroupShort];
// В мобильном меню строка на всю ширину экрана — короткие подписи там не нужны,
// показываем полные («Гостиница Villa ArtE», «Банкетный комплекс»).
const mobileNavGroupLabels = [t.ui.nav.restaurantGroup, t.ui.nav.hotelGroup, t.ui.nav.banquetGroup];
const navGroupItemLabels = [
  [t.ui.nav.history, t.ui.nav.mainMenu, t.ui.nav.kidsMenuPdf, t.ui.nav.barMenuPdf, t.ui.nav.interior],
  [t.ui.nav.bookRoom, t.ui.nav.sauna, t.ui.nav.hotelServices],
  [t.ui.nav.hallRental, t.ui.nav.banquetMenuPdf, t.ui.nav.eventsCatering],
];
const navSingleLabels = [t.ui.nav.carwash, t.ui.nav.reviews, t.ui.nav.gallery, t.ui.nav.contacts];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-burgundy)]/25 bg-paper/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 md:px-8">
    <div class="flex items-center gap-3">
      <button
        id="nav-burger"
        type="button"
        class="flex h-10 w-10 shrink-0 items-center justify-center border border-line xl:hidden"
        aria-label={t.ui.nav.openMenuAria}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">{t.ui.nav.openMenuAria}</span>
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M0 1H18" stroke="currentColor" stroke-width="1.5" />
          <path d="M0 11H18" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
      <a href={localizedHref("/", locale)} class="flex min-w-0 shrink items-center gap-2">
        <img src={withBase("/img/brand/logo.png")} alt="Лесная Заимка" class="h-10 w-auto shrink-0 md:h-12" />
      </a>
    </div>

    {/* Порог xl (1280px), а не lg (1024px): при 3 группах-дропдаунах + 4 одиночных
       пунктах + переключателе языка + двух CTA-кнопках + корзине десктопный ряд
       физически не помещается до 1280px — при lg текст переносился и ломал вёрстку. */}
    <nav class="hidden items-center gap-1 xl:flex" aria-label="Основная навигация">
      {NAV_GROUPS.map((group, gi) => (
        <div class="nav-group relative">
          <button
            type="button"
            class="nav-group-btn flex items-center gap-1 whitespace-nowrap px-2.5 py-2 font-mono text-[13px] tracking-wide text-ink-soft transition-colors hover:text-ink"
            aria-expanded="false"
          >
            {navGroupLabels[gi]}
            <svg width="9" height="6" viewBox="0 0 9 6" fill="none" aria-hidden="true" class="nav-caret transition-transform">
              <path d="M1 1L4.5 5L8 1" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </button>
          <div class="nav-dropdown invisible absolute left-0 top-full z-10 min-w-[220px] translate-y-1 border border-[var(--color-burgundy)]/25 bg-paper-raised py-2 opacity-0 shadow-lg transition-all duration-150">
            {group.items.map((item, ii) => (
              <a
                href={resolveHref(item.href, item.external)}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener" : undefined}
                class="block px-4 py-2 font-mono text-[13px] text-ink-soft hover:bg-paper-sunk/60 hover:text-ink"
              >
                {navGroupItemLabels[gi][ii]}
              </a>
            ))}
          </div>
        </div>
      ))}
      {NAV_SINGLE.map((item, i) => (
        <a
          href={resolveHref(item.href, item.external)}
          class="whitespace-nowrap px-2.5 py-2 font-mono text-[13px] tracking-wide text-ink-soft transition-colors hover:text-ink"
        >
          {navSingleLabels[i]}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-2.5 xl:flex">
      <div class="nav-group relative">
        <button type="button" class="nav-group-btn flex items-center gap-1 border border-line px-2.5 py-2 font-mono text-[12px] tracking-wide text-ink-soft transition-colors hover:text-ink" aria-expanded="false">
          {LOCALE_LABELS[locale]}
          <svg width="8" height="5" viewBox="0 0 9 6" fill="none" aria-hidden="true" class="nav-caret transition-transform"><path d="M1 1L4.5 5L8 1" stroke="currentColor" stroke-width="1.4" /></svg>
        </button>
        <div class="nav-dropdown invisible absolute right-0 top-full z-10 mt-1 min-w-[110px] translate-y-1 border border-[var(--color-burgundy)]/25 bg-paper-raised py-1 opacity-0 shadow-lg transition-all duration-150">
          {LOCALES.map((l) => (
            <a
              href={localizedHref(path, l)}
              class:list={["block px-4 py-1.5 font-mono text-[13px]", l === locale ? "text-brass" : "text-ink-soft hover:text-ink"]}
            >
              {LOCALE_LABELS[l]}
            </a>
          ))}
        </div>
      </div>
      <a
        href={eventsFormHref}
        class="whitespace-nowrap border border-ink px-4 py-2 font-mono text-[12.5px] tracking-wide text-ink transition-colors duration-[var(--dur-micro)] ease-[var(--ease-micro)] hover:bg-ink hover:text-paper-raised"
      >
        {t.ui.common.eventRequestBtn}
      </a>
      <a
        href={contactsHref}
        class="plaque whitespace-nowrap bg-[var(--color-burgundy)] px-4 py-2 font-mono text-[12.5px] tracking-wide text-paper-raised transition-colors duration-[var(--dur-micro)] ease-[var(--ease-micro)] hover:bg-[var(--color-gold)] hover:text-ink"
      >
        {t.ui.common.bookTableBtn}
      </a>
      <button
        type="button"
        data-cart-open
        aria-label={t.ui.common.openPreorderAria}
        class="relative flex h-10 w-10 items-center justify-center border border-line text-ink-soft transition-colors hover:border-ink hover:text-ink"
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M2 5h2l1.2 8.4a1.5 1.5 0 0 0 1.48 1.3h7.44a1.5 1.5 0 0 0 1.48-1.28L17 7H5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="8" cy="17.5" r="1" fill="currentColor" />
          <circle cx="14" cy="17.5" r="1" fill="currentColor" />
        </svg>
        <span data-cart-badge class="absolute -right-1.5 -top-1.5 hidden min-w-[18px] rounded-full bg-[var(--color-gold)] px-1 text-center font-mono text-[10px] font-semibold leading-[18px] text-ink"></span>
      </button>
    </div>
  </div>
</header>

<!-- Вынесены за пределы <header>: у него position:sticky, а sticky-предок
     создаёт containing block для position:fixed потомков — драйвер вместо
     экрана позиционировался бы относительно 64px-полосы шапки. -->
<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-40 hidden bg-ink/60 backdrop-blur-sm xl:hidden"
></div>

<nav
    id="mobile-nav"
    class="fixed inset-y-0 left-0 z-50 flex w-[85vw] max-w-[340px] -translate-x-full flex-col gap-1 overflow-y-auto bg-paper-raised px-5 py-4 shadow-2xl transition-transform duration-300 ease-out xl:hidden"
    aria-label="Мобильная навигация"
  >
    <div class="flex items-center justify-between border-b border-line pb-3">
      <a href={localizedHref("/", locale)} class="flex items-center gap-2">
        <img src={withBase("/img/brand/logo.png")} alt="Лесная Заимка" class="h-9 w-auto" />
      </a>
      <div class="flex items-center gap-2">
        <button
          id="mobile-nav-cart-open"
          type="button"
          data-cart-open
          aria-label={t.ui.common.openPreorderAria}
          class="relative flex h-9 w-9 items-center justify-center border border-line text-ink-soft"
        >
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M2 5h2l1.2 8.4a1.5 1.5 0 0 0 1.48 1.3h7.44a1.5 1.5 0 0 0 1.48-1.28L17 7H5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="8" cy="17.5" r="1" fill="currentColor" />
            <circle cx="14" cy="17.5" r="1" fill="currentColor" />
          </svg>
          <span data-cart-badge class="absolute -right-1.5 -top-1.5 hidden min-w-[18px] rounded-full bg-[var(--color-gold)] px-1 text-center font-mono text-[10px] font-semibold leading-[18px] text-ink"></span>
        </button>
        <button
          id="mobile-nav-close"
          type="button"
          aria-label={t.ui.nav.closeMenuAria}
          class="flex h-9 w-9 items-center justify-center border border-line text-ink-soft"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <div class="flex flex-wrap gap-1.5 border-b border-line/60 py-3">
      {LOCALES.map((l) => (
        <a
          href={localizedHref(path, l)}
          class:list={["border px-2.5 py-1 font-mono text-xs", l === locale ? "border-brass text-brass" : "border-line text-ink-soft"]}
        >
          {LOCALE_LABELS[l]}
        </a>
      ))}
    </div>

    <a href={localizedHref("/", locale)} class="py-2.5 font-mono text-sm font-semibold text-ink">{t.ui.nav.home}</a>

    {NAV_GROUPS.map((group, gi) => (
      <div class="mobile-nav-group border-t border-line/60 pt-1">
        <button
          type="button"
          class="mobile-nav-group-btn flex w-full items-center justify-between py-2.5 font-mono text-sm font-semibold text-ink"
          aria-expanded="false"
        >
          {mobileNavGroupLabels[gi]}
          <svg width="10" height="7" viewBox="0 0 9 6" fill="none" aria-hidden="true" class="mobile-nav-caret transition-transform">
            <path d="M1 1L4.5 5L8 1" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </button>
        <div class="mobile-nav-panel hidden flex-col gap-0.5 pb-2 pl-3">
          {group.items.map((item, ii) => (
            <a
              href={resolveHref(item.href, item.external)}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener" : undefined}
              class="py-2 font-mono text-[13px] text-ink-soft"
            >
              {navGroupItemLabels[gi][ii]}
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="border-t border-line/60 pt-1">
      {NAV_SINGLE.map((item, i) => (
        <a href={resolveHref(item.href, item.external)} class="block py-2.5 font-mono text-sm text-ink-soft">{navSingleLabels[i]}</a>
      ))}
    </div>

    <div class="mt-3 flex flex-col gap-2">
      <a href={eventsFormHref} class="border border-ink px-4 py-3 text-center font-mono text-[13px] text-ink">{t.ui.common.eventRequestBtn}</a>
      <a href={contactsHref} class="plaque bg-[var(--color-burgundy)] px-4 py-3 text-center font-mono text-[13px] text-paper-raised">{t.ui.common.bookTableBtn}</a>
    </div>
</nav>

<script>
  // Мобильное меню — выезжающая слева панель (off-canvas), как у burnyrest.ru:
  // фиксированная панель translate-x на весь экран по высоте + затемнение фона,
  // а не выпадающий блок под шапкой.
  const burger = document.getElementById("nav-burger");
  const mobileNav = document.getElementById("mobile-nav");
  const mobileNavClose = document.getElementById("mobile-nav-close");
  const mobileNavOverlay = document.getElementById("mobile-nav-overlay");
  const mobileNavCartOpen = document.getElementById("mobile-nav-cart-open");

  function openMobileNav() {
    mobileNav?.classList.remove("-translate-x-full");
    mobileNavOverlay?.classList.remove("hidden");
    burger?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }
  function closeMobileNav() {
    mobileNav?.classList.add("-translate-x-full");
    mobileNavOverlay?.classList.add("hidden");
    burger?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }
  burger?.addEventListener("click", () => {
    const isOpen = burger.getAttribute("aria-expanded") === "true";
    isOpen ? closeMobileNav() : openMobileNav();
  });
  mobileNavClose?.addEventListener("click", closeMobileNav);
  mobileNavOverlay?.addEventListener("click", closeMobileNav);
  // Корзина открывается СВОИМ обработчиком в CartDrawer.astro (через
  // data-cart-open) — здесь только закрываем панель меню под ней, чтобы
  // не оставались два открытых оверлея одновременно.
  mobileNavCartOpen?.addEventListener("click", closeMobileNav);

  // Мобильные группы — аккордеон (клик разворачивает, остальные не трогает,
  // можно открыть несколько сразу — это ожидаемое поведение accordion-меню).
  document.querySelectorAll<HTMLElement>(".mobile-nav-group").forEach((group) => {
    const btn = group.querySelector<HTMLButtonElement>(".mobile-nav-group-btn");
    const panel = group.querySelector<HTMLElement>(".mobile-nav-panel");
    const caret = group.querySelector<HTMLElement>(".mobile-nav-caret");
    btn?.addEventListener("click", () => {
      const isOpen = panel?.classList.toggle("hidden") === false;
      panel?.classList.toggle("flex", isOpen);
      btn.setAttribute("aria-expanded", String(isOpen));
      caret?.classList.toggle("rotate-180", isOpen);
    });
  });

  // Десктопные dropdown-группы — клик открывает/закрывает, клик вне закрывает,
  // Escape закрывает. Не hover-only: на touch-устройствах между lg-брейкпоинтом
  // и мышью hover ненадёжен, клик работает везде одинаково.
  const groups = Array.from(document.querySelectorAll<HTMLElement>(".nav-group"));
  function closeAll(except?: HTMLElement) {
    groups.forEach((g) => {
      if (g === except) return;
      const btn = g.querySelector<HTMLButtonElement>(".nav-group-btn");
      const dropdown = g.querySelector<HTMLElement>(".nav-dropdown");
      const caret = g.querySelector<HTMLElement>(".nav-caret");
      btn?.setAttribute("aria-expanded", "false");
      dropdown?.classList.add("invisible", "opacity-0", "translate-y-1");
      caret?.classList.remove("rotate-180");
    });
  }
  groups.forEach((group) => {
    const btn = group.querySelector<HTMLButtonElement>(".nav-group-btn");
    const dropdown = group.querySelector<HTMLElement>(".nav-dropdown");
    const caret = group.querySelector<HTMLElement>(".nav-caret");
    btn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const willOpen = btn.getAttribute("aria-expanded") !== "true";
      closeAll(willOpen ? group : undefined);
      btn.setAttribute("aria-expanded", String(willOpen));
      dropdown?.classList.toggle("invisible", !willOpen);
      dropdown?.classList.toggle("opacity-0", !willOpen);
      dropdown?.classList.toggle("translate-y-1", !willOpen);
      caret?.classList.toggle("rotate-180", willOpen);
    });
  });
  document.addEventListener("click", () => closeAll());
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeAll();
      closeMobileNav();
    }
  });
</script>
