---
// Отзывы с 2ГИС и Яндекс — по прямому запросу клиента, с вопросом «автоматически
// они будут обновляться?». Честный ответ разный для двух площадок:
//
// Яндекс — да, автоматически: это официальный встраиваемый виджет Яндекса
// (yandex.ru/maps-reviews-widget/{id}) для организации «Лесная Заимка»
// (ул. Маковского, 290, id подтверждён: 1081573454) — реальный iframe с живыми
// отзывами, обновляется сам, никакого стороннего сервиса и оплаты не требует.
//
// 2ГИС — официального бесплатного авто-обновляемого виджета у 2ГИС нет; есть
// платные сторонние агрегаторы (SmartWidgets, Widster и т.п.), но подключать
// платную подписку без согласия клиента на стоимость — не наше решение.
// Поставлена честная прямая ссылка на реальный профиль 2ГИС (тоже всегда
// актуальная, просто с переходом на 2gis.ru, а не встроенная на странице).
import { getContent, type Locale } from "@/lib/i18n";
import { CONTACTS } from "@/data/contacts";
import { staticMapUrl } from "@/lib/map";
import { withBase } from "@/lib/url";

interface Props {
  locale?: Locale;
}
const { locale = "ru" } = Astro.props;
const t = getContent(locale);

// ID/ссылка — из contacts.json (редактируется в админке), а не константы здесь:
// иначе смена организации на Яндекс.Картах или профиля 2ГИС требовала бы правки кода.
// Карта в пустом месте под карточкой 2ГИС — по прямой правке клиента
// («добавь на главной внизу справа в пустом месте карту»): у правой колонки
// была лишняя высота ниже плашки 2ГИС, потому что слева высокий iframe
// отзывов (560px), а справа — только текстовая карточка.
// Картинка (см. src/lib/map.ts), а не интерактивный iframe-виджет — тот же
// урок с «карта не открылась у клиента», см. contacts.astro.
const mapImgSrc = staticMapUrl(CONTACTS.lat, CONTACTS.lon);
---

<section class="border-t border-line bg-paper-sunk/40 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.index.reviewsEyebrow}</p>
    <h2 class="mt-3 max-w-[30ch] font-display text-2xl font-semibold text-ink md:text-3xl" data-reveal>
      {t.pages.index.reviewsH2}
    </h2>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-start">
      <div class="border border-line bg-paper-raised" data-reveal>
        <iframe
          title="Отзывы Яндекс Карт — Лесная Заимка"
          src={`https://yandex.ru/maps-reviews-widget/${CONTACTS.yandexOrgId}?comments`}
          class="h-[560px] w-full border-0"
          loading="lazy"
        ></iframe>
      </div>

      <div class="flex flex-col gap-4 lg:h-[560px]">
        <a
          href={CONTACTS.dgisUrl}
          target="_blank"
          rel="noopener"
          class="plaque flex flex-col bg-paper-raised p-8 transition-colors hover:bg-[var(--color-burgundy-soft)]"
          data-reveal
        >
          <span class="font-mono text-xs uppercase tracking-wide text-brass">{t.pages.index.reviewsDgisLabel}</span>
          <p class="mt-3 font-display text-xl font-semibold text-ink">{t.pages.index.reviewsDgisTitle}</p>
          <p class="mt-3 text-sm text-ink-soft">
            {t.pages.index.reviewsDgisNote}
          </p>
          <span class="mt-6 inline-flex items-center gap-2 font-mono text-[13px] text-ink">{t.pages.index.reviewsDgisOpen}</span>
        </a>

        <a
          href={`https://yandex.ru/maps/?rtext=~${CONTACTS.lat}%2C${CONTACTS.lon}`}
          target="_blank"
          rel="noopener"
          class="relative block min-h-[280px] flex-1 overflow-hidden border border-line"
          aria-label="Открыть карту с расположением «Лесная Заимка» в Яндекс.Картах"
          data-reveal
        >
          <img src={mapImgSrc} alt="Карта — «Лесная Заимка», ул. Маковского, 290" class="h-full w-full object-cover" />
          <span class="pointer-events-none absolute left-1/2 top-1/2 w-36 -translate-x-1/2 -translate-y-1/2 rounded-md border-2 border-[var(--color-burgundy)] bg-paper-raised px-3 py-2.5 shadow-lg">
            <img src={withBase("/img/brand/logo.png")} alt="" class="h-auto w-full" />
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
