---
import { CONTACTS } from "@/data/contacts";
import { getContent, type Locale } from "@/lib/i18n";

interface Props {
  locale?: Locale;
}
const { locale = "ru" } = Astro.props;
const t = getContent(locale);
---

<!-- Плавающая круглая кнопка справа — по прямой правке клиента: «чтобы можно
     было сразу либо написать, либо позвонить», не заходя в раздел «Контакты».
     Один тап разворачивает два варианта (звонок/WhatsApp) вместо мгновенного
     перехода — так случайное касание не запускает звонок сразу. -->
<div id="contact-fab" class="fixed bottom-5 right-5 z-[80] flex flex-col items-end gap-3">
  <div id="contact-fab-options" class="flex hidden flex-col items-end gap-2">
    <a
      href={CONTACTS.phoneTableHref}
      class="plaque flex items-center gap-2 bg-ink px-4 py-2.5 font-mono text-[13px] text-paper-raised shadow-lg transition-colors hover:bg-brass"
    >
      {t.ui.common.phone}
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-paper-raised/15">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C11 21 3 13 3 4.9c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z" fill="currentColor"/></svg>
      </span>
    </a>
    <a
      href={CONTACTS.whatsapp}
      target="_blank"
      rel="noopener"
      class="plaque flex items-center gap-2 bg-[#25D366] px-4 py-2.5 font-mono text-[13px] text-white shadow-lg transition-colors hover:brightness-95"
    >
      WhatsApp
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.07L2 22l5.07-1.33A9.95 9.95 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm0 18c-1.6 0-3.1-.44-4.38-1.2l-.31-.19-3.01.79.8-2.93-.2-.32A7.94 7.94 0 0 1 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8Zm4.36-5.61c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.18-.71-.63-1.19-1.41-1.33-1.65-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.46-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"/></svg>
      </span>
    </a>
    <a
      href={CONTACTS.telegram}
      target="_blank"
      rel="noopener"
      class="plaque flex items-center gap-2 bg-[#229ED9] px-4 py-2.5 font-mono text-[13px] text-white shadow-lg transition-colors hover:brightness-95"
    >
      Telegram
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2Zm4.86 6.86-1.7 8.02c-.13.58-.47.72-.94.45l-2.6-1.92-1.26 1.21c-.14.14-.26.26-.53.26l.19-2.67 4.86-4.39c.21-.19-.05-.29-.32-.11l-6.01 3.78-2.59-.81c-.56-.18-.57-.56.12-.83l10.12-3.9c.47-.17.88.11.66.91Z"/></svg>
      </span>
    </a>
    <a
      href={CONTACTS.maxMessenger}
      target="_blank"
      rel="noopener"
      class="plaque flex items-center gap-2 bg-[#4A90E2] px-4 py-2.5 font-mono text-[13px] text-white shadow-lg transition-colors hover:brightness-95"
    >
      MAX
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5c0-1.1.9-2 2-2h12c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H9l-4 4v-4H6c-1.1 0-2-.9-2-2V5Z" fill="currentColor"/></svg>
      </span>
    </a>
  </div>

  <button
    id="contact-fab-toggle"
    type="button"
    aria-expanded="false"
    aria-label={t.ui.common.contactUsAria}
    class="flex h-14 w-14 items-center justify-center rounded-full bg-[var(--color-burgundy)] text-paper-raised shadow-xl transition-transform hover:scale-105 active:scale-95"
  >
    <svg id="contact-fab-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="transition-transform">
      <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.07L2 22l5.07-1.33A9.95 9.95 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm0 18c-1.6 0-3.1-.44-4.38-1.2l-.31-.19-3.01.79.8-2.93-.2-.32A7.94 7.94 0 0 1 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8Zm4.36-5.61c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.18-.71-.63-1.19-1.41-1.33-1.65-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.46-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.13 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"/>
    </svg>
  </button>
</div>

<script>
  const toggle = document.getElementById("contact-fab-toggle");
  const options = document.getElementById("contact-fab-options");
  const icon = document.getElementById("contact-fab-icon");
  toggle?.addEventListener("click", () => {
    const willOpen = options?.classList.contains("hidden");
    options?.classList.toggle("hidden", !willOpen);
    options?.classList.toggle("flex", willOpen);
    toggle.setAttribute("aria-expanded", String(willOpen));
    icon?.classList.toggle("rotate-45", willOpen);
  });
  document.addEventListener("click", (e) => {
    const fab = document.getElementById("contact-fab");
    if (fab && !fab.contains(e.target as Node) && !options?.classList.contains("hidden")) {
      options?.classList.add("hidden");
      options?.classList.remove("flex");
      toggle?.setAttribute("aria-expanded", "false");
      icon?.classList.remove("rotate-45");
    }
  });
</script>
