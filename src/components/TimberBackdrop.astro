---
import { withBase } from "@/lib/url";

// Фон-«сруб» — по прямому референсу: реальное фото брёвен дома вместо
// абстрактного WebGL-градиента (тот дал сильную просадку Performance и,
// по отзыву, «не было фишки»; референс-скриншот показал, что нужна была
// не абстракция, а настоящая фактура дерева). Фото — реальный кадр с
// клиентской фотосессии 2026 (Основной зал, CG0A4083.jpg), не сток и не
// сгенерировано. Артдирекшн через <picture>: на мобильном — портретный
// кроп того же зала.
// Статичное фото не зависит от motionEnabled() — виден всегда (в т.ч. при
// prefers-reduced-motion), лёгкий параллакс/тилт добавляется поверх через GSAP.
// По прямой правке клиента: только фото, без каких-либо слоёв поверх —
// ни тёмной вуали, ни блюра, ни зерна. Контраст текста держит только
// полупрозрачная подложка main (bg-paper/55, см. Layout.astro) — проверено
// расчётом (WCAG) по всей фотографии: даже в самой тёмной точке фото под
// текстом контраст --color-ink не ниже ~4.9:1 (мин. по стандарту — 4.5:1).
---

<div id="timber-backdrop" aria-hidden="true" class="fixed inset-0 z-0 overflow-hidden">
  <picture>
    <source media="(max-width: 767px)" srcset={withBase("/img/bg/timber-wall-mobile.webp")} />
    <img
      id="timber-backdrop-img"
      src={withBase("/img/bg/timber-wall.webp")}
      alt=""
      fetchpriority="high"
      class="absolute inset-0 h-[112%] w-full scale-[1.04] object-cover object-[85%_30%] md:object-[70%_25%]"
    />
  </picture>
</div>

<script>
  import { motionEnabled, gsap } from "@/lib/motion";

  function initTimberParallax() {
    if (!motionEnabled()) return;
    const img = document.getElementById("timber-backdrop-img");
    if (!img) return;

    // Глубина при скролле — тот же приём, что раньше был на WebGL-сцене
    // (лёгкий сдвиг сцены при погружении в страницу), но здесь это дешёвый
    // CSS-transform на одном <img>, а не пересчёт шейдера каждый кадр.
    gsap.to(img, {
      yPercent: -6,
      ease: "none",
      scrollTrigger: { trigger: document.body, start: "top top", end: "bottom bottom", scrub: 0.6 },
    });

    // Курсор — едва заметный параллакс-тилт, сглаженный через quickTo.
    const xTo = gsap.quickTo(img, "xPercent", { duration: 0.9, ease: "power3.out" });
    const yTo = gsap.quickTo("#timber-backdrop-img", "rotationZ", { duration: 1.2, ease: "power3.out" });
    window.addEventListener(
      "pointermove",
      (e) => {
        const nx = (e.clientX / window.innerWidth - 0.5) * 2;
        const ny = (e.clientY / window.innerHeight - 0.5) * 2;
        xTo(nx * -1.2);
        yTo(nx * ny * 0.4);
      },
      { passive: true }
    );
  }

  initTimberParallax();
</script>
