---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import TimberBackdrop from "@/components/TimberBackdrop.astro";
import CartDrawer from "@/components/CartDrawer.astro";
import ContactFab from "@/components/ContactFab.astro";
import { CONTACTS } from "@/data/contacts";
import { ZAIMKA_MENU } from "@/data/menu";
import { THEME } from "@/data/theme";
import { withBase } from "@/lib/url";
import { LOCALES, DEFAULT_LOCALE, localizedHref, type Locale } from "@/lib/i18n";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Путь до превью-картинки (без домена, с withBase уже проведён снаружи не нужно — Layout сам достроит абсолютный URL). */
  image?: string;
  /** Для страниц, которые не должны индексироваться (404 и т.п.) */
  noindex?: boolean;
  /** Язык страницы. По умолчанию "ru" — не влияет на существующие RU-страницы. */
  locale?: Locale;
  /**
   * Путь БЕЗ языкового префикса и БЕЗ base, например "/menu/" — нужен только
   * чтобы построить hreflang-альтернативы на другие языковые версии этой же
   * страницы. Если не передан, hreflang-блок не рендерится (для страниц без
   * переводов).
   */
  path?: string;
}

const { title, description, image = "/img/hero-index.webp", noindex = false, locale = DEFAULT_LOCALE, path } = Astro.props;

const OG_LOCALE: Record<Locale, string> = { ru: "ru_RU", en: "en_US", zh: "zh_CN", ko: "ko_KR" };

// Те же переводы кухонь, что уже используются в текстах сайта (см.
// i18n/content.*.ts, описание index/menu) — не придуманы заново для JSON-LD.
const CUISINE: Record<Locale, string[]> = {
  ru: ["Русская", "Охотничья", "Дальневосточная", "Кавказская"],
  en: ["Russian", "Game", "Far Eastern", "Caucasian"],
  zh: ["俄罗斯菜", "猎人菜", "远东菜", "高加索菜"],
  ko: ["러시아 요리", "사냥육 요리", "극동 요리", "캅카스 요리"],
};

// Реальный диапазон цен из данных меню — для priceRange в JSON-LD, не выдумано.
const allPrices = ZAIMKA_MENU.categories.flatMap((c) => c.items.map((i) => i.price));
const minPrice = Math.min(...allPrices);
const maxPrice = Math.max(...allPrices);
// Astro.site не задан (нужно проверить: домен продакшена ещё не определён — см. Фазу 7,
// «что проверить перед публикацией»), поэтому canonical/og:image рендерим только когда он есть —
// у соцсетей и мессенджеров превью всё равно требует абсолютный URL, относительный не сработает.
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const ogImageURL = Astro.site ? new URL(withBase(image), Astro.site) : null;

// JSON-LD ниже раньше дублировал адрес/телефон отдельными строками — правка
// адреса или телефона в админке молча расходилась с структурированными
// данными для поисковиков. streetAddress/telephone теперь выводятся из
// CONTACTS (единственный источник); openingHours оставлен отдельной строкой —
// формат schema.org ("Mo-Su 11:00-24:00") не разбирается надёжно из свободного
// текста CONTACTS.hours ("Без выходных, с 11:00 до 00:00"), править вручную
// при реальном изменении часов работы.
const jsonLdStreetAddress = CONTACTS.address.replace(/^г\.\s*Владивосток,\s*/i, "");
const jsonLdTelephone = CONTACTS.phoneTableHref.replace(/^tel:/, "");
---

<!doctype html>
<html lang={locale} prefix="og: http://ogp.me/ns# restaurant: http://ogp.me/ns/restaurant#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {path && LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(localizedHref(path, l), Astro.site)} />)}
    {path && <link rel="alternate" hreflang="x-default" href={new URL(localizedHref(path, DEFAULT_LOCALE), Astro.site)} />}
    <!-- Шрифты самохостятся через fontsource в global.css — сторонний Google Fonts
         запрос больше не нужен (см. комментарий в global.css). -->
    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    {ogImageURL && <meta name="twitter:card" content="summary_large_image" />}
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Restaurant",
      name: CONTACTS.name,
      ...(Astro.site ? { url: new URL(withBase("/"), Astro.site).toString() } : {}),
      ...(Astro.site ? { image: new URL(withBase("/img/hero-index.webp"), Astro.site).toString() } : {}),
      ...(Astro.site ? { menu: new URL(withBase("/menu/"), Astro.site).toString() } : {}),
      priceRange: `${minPrice}–${maxPrice} ₽`,
      servesCuisine: CUISINE[locale],
      address: {
        "@type": "PostalAddress",
        streetAddress: jsonLdStreetAddress,
        addressLocality: "Владивосток",
        addressCountry: "RU",
      },
      geo: { "@type": "GeoCoordinates", latitude: CONTACTS.lat, longitude: CONTACTS.lon },
      telephone: jsonLdTelephone,
      openingHours: "Mo-Su 11:00-24:00",
      // Реальный рейтинг с Яндекс.Карт (organization id 1081573454, снято
      // вручную 19.08.2026) — не выдумано; при заметном изменении рейтинга
      // на Яндекс.Картах нужно будет обновить эти два числа тоже.
      aggregateRating: { "@type": "AggregateRating", ratingValue: "4.7", ratingCount: "984", bestRating: "5" },
    })} />

    <!-- Тумблер анимаций применяется ДО первой отрисовки, чтобы не было мигания:
         читаем сохранённый выбор из localStorage синхронно, без ожидания гидратации. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("zaimka-motion");
          if (saved === "off") document.documentElement.dataset.motion = "off";
        } catch (e) {}
      })();
    </script>

    <!-- Цвета оформления из /admin/ («Оформление») — переопределяют design-токены
         global.css поверх (та же техника, что уже применялась для перекраски
         логотипа: CSS-переменная, а не правка компонентов). -soft/line — вручную
         пересчитаны color-mix'ом, чтобы не разъезжались с новым базовым цветом. -->
    <style set:html={`:root {
      --color-paper: ${THEME.paper};
      --color-paper-raised: ${THEME.paperRaised};
      --color-paper-sunk: ${THEME.paperSunk};
      --color-ink: ${THEME.ink};
      --color-burgundy: ${THEME.burgundy};
      --color-burgundy-soft: color-mix(in srgb, ${THEME.burgundy} 10%, transparent);
      --color-gold: ${THEME.gold};
      --color-brass: ${THEME.brass};
      --color-brass-soft: color-mix(in srgb, ${THEME.brass} 12%, transparent);
      --color-velvet: ${THEME.velvet};
      --color-velvet-deep: color-mix(in srgb, ${THEME.velvet} 75%, black);
      --color-line: color-mix(in srgb, ${THEME.ink} 14%, transparent);
    }`} />
  </head>
  <body class="bg-paper text-ink">
    <TimberBackdrop />
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-ink focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-paper-raised">
      {locale === "ru" ? "Перейти к содержанию" : "Skip to content"}
    </a>
    <Header locale={locale} path={path} />
    <!-- Полупрозрачная подложка над фото сруба: держит гарантированный
         контраст текста, при этом фактура дерева всё равно просвечивает
         по краям секций и в промежутках между карточками. -->
    <main id="main" class="relative bg-paper/90">
      <slot />
    </main>
    <Footer locale={locale} />
    <CartDrawer locale={locale} />
    <ContactFab locale={locale} />
    <script>
      import { initSmoothScroll } from "@/lib/motion";
      initSmoothScroll();
    </script>
  </body>
</html>
