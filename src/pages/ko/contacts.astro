---
import Layout from "@/layouts/Layout.astro";
import { CONTACTS } from "@/data/contacts";
import ReserveForm from "@/components/ReserveForm";
import { getContent, localizedHref } from "@/lib/i18n";
import { MAP_IMAGE_PATH, mapRouteUrl } from "@/lib/map";
import { withBase } from "@/lib/url";
import { breadcrumbSchema } from "@/lib/breadcrumbs";
import FaqSection from "@/components/FaqSection.astro";

const locale = "ko" as const;
const t = getContent(locale);

const faqItems = [
  {
    question: "「레스나야 자임카」레스토랑은 어디에 있으며 어떻게 가나요?",
    answer: "레스토랑 주소는 블라디보스토크 마콥스코고 거리 290번지로, 시 진입로에 위치해 있습니다. 이 페이지의 버튼을 통해 얀덱스 지도에서 정확한 경로를 확인할 수 있습니다.",
  },
  {
    question: "레스토랑 영업시간은 어떻게 되나요?",
    answer: "레스토랑은 연중무휴로 11:00부터 자정 00:00까지 영업합니다.",
  },
  {
    question: "레스토랑에는 어떤 편의시설이 있나요?",
    answer: "얀덱스 지도와 2GIS의 공식 페이지에 따르면 전용 주차장, 무료 Wi-Fi, 여름 테라스가 있으며 카드 결제, 음식 배달 및 포장이 가능합니다.",
  },
  {
    question: "「레스나야 자임카」의 평점은 어떻게 되나요? 수상 이력이 있나요?",
    answer: "얀덱스 지도에서 5점 만점에 4.7점(평가 984건, '2026년 좋은 장소' 수상), 2GIS에서는 4.9점(평가 503건, 2GIS 2026 어워드 후보)입니다.",
  },
  {
    question: "레스토랑에서 라이브 음악을 들을 수 있나요?",
    answer: "네, 목요일부터 일요일까지 라이브 음악이 연주됩니다.",
  },
  {
    question: "레스토랑 근처에 호텔이 있나요?",
    answer: "네, 바로 옆에 Villa ArtE 호텔 및 사우나가 있습니다.",
  },
];

const mapImgSrc = withBase(MAP_IMAGE_PATH);
const routeUrl = mapRouteUrl(CONTACTS.lat, CONTACTS.lon);
const logoUrl = withBase("/img/brand/logo.png");

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: t.ui.nav.home, url: new URL(localizedHref("/", locale), Astro.site).toString() },
      { name: t.pages.contacts.eyebrow, url: new URL(localizedHref("/contacts/", locale), Astro.site).toString() },
    ])
  : null;
---

<Layout
  title={t.pages.contacts.title}
  description={t.pages.contacts.description}
  image="/img/hero-video-poster.webp"
  locale={locale}
  path="/contacts/"
>
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-16">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.contacts.eyebrow}</p>
      <h1 class="mt-4 font-display text-3xl font-semibold text-ink md:text-4xl" data-reveal>{t.pages.contacts.h1}</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <div class="border-t border-line">
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.contacts.addressLabel}</span>
            <span class="text-right text-ink">{CONTACTS.address}</span>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.contacts.tableBookingLabel}</span>
            <a href={CONTACTS.phoneTableHref} class="text-right text-brass">{CONTACTS.phoneTable}</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.contacts.eventsLabel}</span>
            <a href={CONTACTS.phoneEventsHref} class="text-right text-brass">{CONTACTS.phoneEvents}</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.contacts.whatsappLabel}</span>
            <a href={CONTACTS.whatsapp} target="_blank" rel="noopener" class="text-right text-brass">{t.ui.common.writeWhatsapp}</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.contacts.telegramLabel}</span>
            <a href={CONTACTS.telegram} target="_blank" rel="noopener" class="text-right text-brass">{t.ui.common.writeTelegram}</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.contacts.maxLabel}</span>
            <a href={CONTACTS.maxMessenger} target="_blank" rel="noopener" class="text-right text-brass">{t.ui.common.writeMax}</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.contacts.hoursLabel}</span>
            <span class="text-right text-ink">{CONTACTS.hours}</span>
          </div>
          <div class="flex items-start justify-between gap-6 py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.contacts.nearbyLabel}</span>
            <span class="text-right text-ink">
              {t.pages.contacts.hotelAndSauna} <a href={CONTACTS.hotel.url} target="_blank" rel="noopener" class="text-brass underline underline-offset-2">{CONTACTS.hotel.name}</a>
            </span>
          </div>
        </div>
      </div>

      <div data-reveal>
        <h2 class="font-display text-xl font-semibold text-ink">{t.pages.contacts.bookTitle}</h2>
        <p class="mt-2 text-sm text-ink-soft">{t.pages.contacts.bookLead}</p>
        <div class="mt-6">
          <ReserveForm client:load locale={locale} />
        </div>
      </div>
    </div>

    <div class="mt-16 max-w-[700px]" data-reveal>
      <div
        class="relative h-[340px] w-full overflow-hidden border border-line md:h-[440px]"
        data-yandex-map
        data-lat={CONTACTS.lat}
        data-lon={CONTACTS.lon}
        data-zoom="17"
        data-api-key={CONTACTS.yandexMapsApiKey}
        data-logo={logoUrl}
        data-route={routeUrl}
      >
        <a
          href={routeUrl}
          target="_blank"
          rel="noopener"
          class="absolute inset-0 block"
          aria-label="야ン덱스 지도에서 «레스나야 자임카» 위치 열기"
          data-map-fallback
        >
          <img src={mapImgSrc} alt="지도 — 레스나야 자임카, 마콥스코고 거리 290" class="h-full w-full object-cover" />
          <span class="pointer-events-none absolute left-1/2 top-1/2 flex w-32 -translate-x-1/2 -translate-y-full flex-col items-center">
            <img src={logoUrl} alt="" class="h-auto w-full drop-shadow-[0_2px_6px_rgba(0,0,0,0.55)]" />
            <span class="h-0 w-0 border-x-[7px] border-x-transparent border-t-[11px] border-t-[var(--color-burgundy)] drop-shadow-[0_1px_2px_rgba(0,0,0,0.35)]"></span>
          </span>
        </a>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={routeUrl}
          target="_blank"
          rel="noopener"
          class="plaque inline-flex items-center gap-2 bg-[var(--color-burgundy)] px-5 py-3 font-mono text-[13px] tracking-wide text-paper-raised transition-colors hover:bg-[var(--color-gold)] hover:text-ink"
        >
          {t.pages.contacts.routeBtn}
        </a>
        <a
          href={CONTACTS.dgisUrl}
          target="_blank"
          rel="noopener"
          class="plaque inline-flex items-center gap-2 border border-line bg-paper-raised px-5 py-3 font-mono text-[13px] tracking-wide text-ink transition-colors hover:bg-[var(--color-burgundy-soft)]"
        >
          {t.pages.contacts.route2gisBtn}
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper-sunk/40 py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <FaqSection heading="자주 묻는 질문" items={faqItems} />
    </div>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    import { initInteractiveMaps } from "@/lib/yandexMap";
    initReveal();
    initInteractiveMaps();
  </script>
</Layout>
