---
import Layout from "@/layouts/Layout.astro";
import { getContent, localizedHref } from "@/lib/i18n";
import { CONTACTS } from "@/data/contacts";
import { breadcrumbSchema } from "@/lib/breadcrumbs";

const locale = "ko" as const;
const t = getContent(locale);

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: t.ui.nav.home, url: new URL(localizedHref("/", locale), Astro.site).toString() },
      { name: t.pages.reviews.eyebrow, url: new URL(localizedHref("/reviews/", locale), Astro.site).toString() },
    ])
  : null;
---

<Layout
  title={t.pages.reviews.title}
  description={t.pages.reviews.description}
  image="/img/halls/osnovnoy/full/1.webp"
  locale={locale}
  path="/reviews/"
>
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-raised">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.reviews.eyebrow}</p>
      <h1 class="mt-4 max-w-[24ch] font-display text-3xl font-semibold leading-[1.02] text-ink md:text-5xl" data-reveal>
        {t.pages.reviews.h1}
      </h1>
      <p class="mt-5 max-w-[62ch] text-ink-soft md:text-lg" data-reveal>
        {t.pages.reviews.lead}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {t.data.reviews.map((r) => (
        <blockquote class="plaque flex flex-col justify-between bg-paper-raised p-7" data-reveal>
          <p class="text-ink">«{r.text}»</p>
          <footer class="mt-5 border-t border-line pt-4 font-mono text-xs text-ink-faint">
            <span class="block font-body text-sm text-ink">{r.author}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-[var(--color-velvet-deep)] py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--color-gold)]" data-reveal>{t.pages.reviews.honoredEyebrow}</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {t.data.guestQuotes.map((q) => (
          <blockquote class="frame-gold bg-transparent p-7" data-reveal>
            <p class="text-paper-raised">«{q.text}»</p>
            <footer class="mt-4 font-mono text-xs text-paper-sunk/70">
              <span class="block font-body text-sm not-italic text-[var(--color-gold)]">{q.author}</span>
              {q.role}
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 text-center md:px-8 md:py-20">
    <p class="text-ink">{t.pages.reviews.shareLead}</p>
    <a
      href={CONTACTS.whatsapp}
      target="_blank"
      rel="noopener"
      class="plaque mt-5 inline-flex items-center gap-2 bg-ink px-5 py-3 font-mono text-[13px] tracking-wide text-paper-raised transition-colors hover:bg-brass"
    >
      {t.ui.common.writeWhatsapp} →
    </a>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    initReveal();
  </script>
</Layout>
