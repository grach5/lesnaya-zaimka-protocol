---
import Layout from "@/layouts/Layout.astro";
import { ZAIMKA_GALLERY } from "@/data/gallery";
import { withBase } from "@/lib/url";
import { getContent, localizedHref } from "@/lib/i18n";
import { breadcrumbSchema } from "@/lib/breadcrumbs";

const locale = "en" as const;
const t = getContent(locale);

const totalImages = ZAIMKA_GALLERY.sections.reduce((sum, s) => sum + s.images.length, 0);
// Переведённые названия разделов — по индексу, порядок идентичен ZAIMKA_GALLERY.
const sectionNames = ZAIMKA_GALLERY.sections.map((s, i) => t.data.gallerySections[i] ?? s.name);

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: t.ui.nav.home, url: new URL(localizedHref("/", locale), Astro.site).toString() },
      { name: t.pages.gallery.eyebrow, url: new URL(localizedHref("/gallery/", locale), Astro.site).toString() },
    ])
  : null;
---

<Layout
  title={t.pages.gallery.title}
  description={t.pages.gallery.description.replace("{n}", String(totalImages))}
  image={ZAIMKA_GALLERY.sections[0].images[0].full}
  locale={locale}
  path="/gallery/"
>
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-16">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.gallery.eyebrow}</p>
      <h1 class="mt-4 font-display text-3xl font-semibold text-ink md:text-4xl" data-reveal>{t.pages.gallery.h1.replace("{n}", String(totalImages))}</h1>
      <p class="mt-4 max-w-[62ch] text-ink-soft" data-reveal>
        {t.pages.gallery.lead}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-10 md:px-8">
    <nav id="gallery-tabs" class="flex flex-wrap gap-2" aria-label="Gallery filter">
      <button type="button" class="gallery-tab border border-ink bg-ink px-3 py-1.5 font-mono text-xs text-paper-raised" data-section="all" aria-pressed="true">
        {t.pages.gallery.allPhotos}
      </button>
      {ZAIMKA_GALLERY.sections.map((s, si) => (
        <button type="button" class="gallery-tab border border-line px-3 py-1.5 font-mono text-xs text-ink-soft" data-section={s.name} aria-pressed="false">
          {sectionNames[si]} ({s.images.length})
        </button>
      ))}
    </nav>

    <div id="gallery-grid" class="mt-8 grid grid-cols-2 gap-2 pb-20 sm:grid-cols-3 md:grid-cols-4">
      {(() => {
        let globalIndex = 0;
        return ZAIMKA_GALLERY.sections.flatMap((s, si) =>
          s.images.map((img, i) => {
            const isAboveFold = globalIndex < 8;
            globalIndex += 1;
            return (
              <button
                type="button"
                class="gallery-thumb block aspect-square overflow-hidden bg-paper-sunk"
                data-section={s.name}
                data-full={withBase(img.full)}
                aria-label={t.pages.events.hallPhotoAria.replace("{hall}", sectionNames[si]).replace("{i}", String(i + 1)).replace("{n}", String(s.images.length))}
              >
                <img
                  src={withBase(img.thumb)}
                  alt={`${sectionNames[si]} — Lesnaya Zaimka, photo ${i + 1}/${s.images.length}`}
                  loading={isAboveFold ? "eager" : "lazy"}
                  width="400"
                  height="400"
                  class="h-full w-full object-cover"
                />
              </button>
            );
          })
        );
      })()}
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-[200] hidden items-center justify-center bg-ink/95 p-6" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button id="lightbox-close" type="button" class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label={t.ui.common.closeAria}>✕</button>
    <button id="lightbox-prev" type="button" class="absolute left-5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label={t.ui.common.prevPhotoAria}>‹</button>
    <div
      id="lightbox-spinner"
      class="pointer-events-none absolute hidden h-8 w-8 animate-spin rounded-full border-2 border-paper-raised/25 border-t-paper-raised"
      aria-hidden="true"
    ></div>
    <img id="lightbox-img" src="" alt="" class="max-h-[86vh] max-w-[92vw] object-contain" />
    <button id="lightbox-next" type="button" class="absolute right-5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label={t.ui.common.nextPhotoAria}>›</button>
  </div>

  <script>
    const tabsEl = document.getElementById("gallery-tabs") as HTMLElement;
    const gridEl = document.getElementById("gallery-grid") as HTMLElement;
    const lightbox = document.getElementById("lightbox") as HTMLElement;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const lightboxSpinner = document.getElementById("lightbox-spinner") as HTMLElement;
    const closeBtn = document.getElementById("lightbox-close") as HTMLButtonElement;
    const prevBtn = document.getElementById("lightbox-prev") as HTMLButtonElement;
    const nextBtn = document.getElementById("lightbox-next") as HTMLButtonElement;

    const allThumbs = Array.from(gridEl.querySelectorAll<HTMLButtonElement>(".gallery-thumb"));
    let visibleThumbs = allThumbs;
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function applyFilter(section: string) {
      allThumbs.forEach((t) => {
        const match = section === "all" || t.dataset.section === section;
        t.classList.toggle("hidden", !match);
      });
      visibleThumbs = allThumbs.filter((t) => !t.classList.contains("hidden"));
    }

    tabsEl.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(".gallery-tab");
      if (!btn) return;
      tabsEl.querySelectorAll(".gallery-tab").forEach((t) => {
        t.setAttribute("aria-pressed", "false");
        t.classList.remove("bg-ink", "text-paper-raised", "border-ink");
        t.classList.add("border-line", "text-ink-soft");
      });
      btn.setAttribute("aria-pressed", "true");
      btn.classList.add("bg-ink", "text-paper-raised", "border-ink");
      btn.classList.remove("border-line", "text-ink-soft");
      applyFilter(btn.dataset.section ?? "all");
    });

    const fullImageCache = new Set<string>();
    function preload(src: string) {
      if (!src || fullImageCache.has(src)) return;
      fullImageCache.add(src);
      const img = new Image();
      img.src = src;
    }
    function preloadNeighbors(idx: number) {
      const next = visibleThumbs[(idx + 1) % visibleThumbs.length]?.dataset.full;
      const prev = visibleThumbs[(idx - 1 + visibleThumbs.length) % visibleThumbs.length]?.dataset.full;
      if (next) preload(next);
      if (prev) preload(prev);
    }
    function showPhoto(idx: number) {
      const thumb = visibleThumbs[idx];
      const thumbSrc = thumb.querySelector("img")?.src ?? "";
      const fullSrc = thumb.dataset.full ?? "";
      lightboxImg.alt = thumb.querySelector("img")?.alt ?? "";

      if (fullImageCache.has(fullSrc)) {
        lightboxImg.src = fullSrc;
        lightboxSpinner.classList.add("hidden");
      } else {
        lightboxImg.src = thumbSrc;
        lightboxSpinner.classList.remove("hidden");
        const loader = new Image();
        loader.onload = () => {
          fullImageCache.add(fullSrc);
          if (currentIndex === idx) {
            lightboxImg.src = fullSrc;
            lightboxSpinner.classList.add("hidden");
          }
        };
        loader.onerror = () => {
          if (currentIndex === idx) lightboxSpinner.classList.add("hidden");
        };
        loader.src = fullSrc;
      }
      preloadNeighbors(idx);
    }
    function openLightbox(idx: number, triggerEl: HTMLElement | null) {
      currentIndex = idx;
      lastFocused = triggerEl ?? (document.activeElement as HTMLElement | null);
      showPhoto(idx);
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      closeBtn.focus();
    }
    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      lastFocused?.focus();
    }
    function step(delta: number) {
      currentIndex = (currentIndex + delta + visibleThumbs.length) % visibleThumbs.length;
      showPhoto(currentIndex);
    }

    allThumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const idx = visibleThumbs.indexOf(thumb);
        if (idx > -1) openLightbox(idx, thumb);
      });
    });

    closeBtn.addEventListener("click", closeLightbox);
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
      if (e.key === "Tab") {
        const focusables = [prevBtn, nextBtn, closeBtn];
        const idx = focusables.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        const next = e.shiftKey ? (idx <= 0 ? focusables.length - 1 : idx - 1) : idx === -1 || idx === focusables.length - 1 ? 0 : idx + 1;
        focusables[next].focus();
      }
    });
  </script>

  <script>
    import { initReveal } from "@/lib/motion";
    initReveal();
  </script>
</Layout>
