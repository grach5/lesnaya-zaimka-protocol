---
import Layout from "@/layouts/Layout.astro";
import { CONTACTS } from "@/data/contacts";
import { getContent } from "@/lib/i18n";

const locale = "en" as const;
const t = getContent(locale);
---

<Layout title={t.pages.carwash.title} description={t.pages.carwash.description} locale={locale} path="/carwash/">
  <section class="border-b border-line bg-[var(--color-forest-deep)]">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--color-gold)]" data-reveal>{t.pages.carwash.eyebrow}</p>
      <h1 class="mt-4 max-w-[22ch] font-display text-3xl font-semibold leading-[1.02] text-paper-raised md:text-5xl" data-reveal>
        {t.pages.carwash.h1}
      </h1>
      <p class="mt-5 max-w-[62ch] text-paper-sunk/85 md:text-lg" data-reveal>
        {t.pages.carwash.lead}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.carwash.servicesEyebrow}</p>
    <div class="mt-6 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 md:grid-cols-3" data-reveal>
      {t.data.carwashCategories.map((cat) => (
        <div class="bg-paper-raised p-6">
          <span class="font-display text-lg text-ink">{cat}</span>
        </div>
      ))}
    </div>
    <p class="mt-6 max-w-[62ch] text-sm text-ink-faint" data-reveal>
      {t.pages.carwash.note}
    </p>

    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
      <a
        href={CONTACTS.phoneTableHref}
        class="plaque bg-[var(--color-burgundy)] px-5 py-3 font-mono text-[13px] tracking-wide text-paper-raised transition-colors hover:bg-[var(--color-gold)] hover:text-ink"
      >
        {CONTACTS.phoneTable}
      </a>
      <a
        href={CONTACTS.whatsapp}
        target="_blank"
        rel="noopener"
        class="border border-ink px-5 py-3 font-mono text-[13px] text-ink transition-colors hover:bg-ink hover:text-paper-raised"
      >
        {t.ui.common.writeWhatsapp}
      </a>
    </div>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    initReveal();
  </script>
</Layout>
