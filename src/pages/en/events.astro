---
import Layout from "@/layouts/Layout.astro";
import { HALLS } from "@/data/halls";
import { CONTACTS } from "@/data/contacts";
import { withBase } from "@/lib/url";
import BookingForm from "@/components/BookingForm";
import HallCarousel from "@/components/HallCarousel.astro";
import { getContent, localizedHref } from "@/lib/i18n";
import { breadcrumbSchema } from "@/lib/breadcrumbs";

const locale = "en" as const;
const t = getContent(locale);

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: t.ui.nav.home, url: new URL(localizedHref("/", locale), Astro.site).toString() },
      { name: t.pages.events.eyebrow, url: new URL(localizedHref("/events/", locale), Astro.site).toString() },
    ])
  : null;
---

<Layout
  title={t.pages.events.title}
  description={t.pages.events.description}
  image="/img/halls/osnovnoy/full/1.webp"
  locale={locale}
  path="/events/"
>
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.events.eyebrow}</p>
      <h1 class="mt-4 max-w-[22ch] font-display text-3xl font-semibold leading-[1.02] text-ink md:text-5xl" data-reveal>
        {t.pages.events.h1}
      </h1>
      <p class="mt-5 max-w-[62ch] text-ink-soft md:text-lg" data-reveal>
        {t.pages.events.lead}
      </p>
      <div class="mt-6 flex flex-wrap gap-2" data-reveal>
        {t.data.eventFormats.map((f) => (
          <span class="border border-line bg-paper-raised px-3 py-1.5 font-mono text-xs text-ink-soft">{f}</span>
        ))}
      </div>
      <a
        href={withBase("/pdf/banketnoe-menu.pdf")}
        target="_blank"
        rel="noopener"
        class="plaque mt-6 inline-flex items-center gap-2 bg-[var(--color-burgundy)] px-5 py-3 font-mono text-[13px] tracking-wide text-paper-raised transition-colors hover:bg-[var(--color-gold)] hover:text-ink"
      >
        {t.pages.events.menuPdfBtn}
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.events.hallsEyebrow}</p>
    <h2 class="mt-3 max-w-[30ch] font-display text-2xl font-semibold text-ink md:text-3xl" data-reveal>
      {t.pages.events.hallsH2}
    </h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {HALLS.map((hall, i) => (
        <HallCarousel
          hall={hall}
          index={i}
          locale={locale}
          name={t.data.halls[i]?.name}
          description={t.data.halls[i]?.description}
          capacity={t.data.halls[i]?.capacity}
          area={t.data.halls[i]?.area}
        />
      ))}
    </div>
  </section>

  <section id="form" class="border-t border-line bg-paper-sunk/40 scroll-mt-20">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr]">
        <div data-reveal>
          <p class="font-mono text-xs uppercase tracking-wide text-brass">{t.pages.events.formEyebrow}</p>
          <h2 class="mt-3 font-display text-2xl font-semibold text-ink md:text-3xl">
            {t.pages.events.formH2}
          </h2>
          <p class="mt-4 max-w-[46ch] text-ink-soft">
            {t.pages.events.formLead}
          </p>
          <div class="mt-8 border-t border-line pt-6">
            <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">{t.pages.events.deptLabel}</p>
            <a href={CONTACTS.phoneEventsHref} class="mt-2 block font-display text-xl text-ink">{CONTACTS.phoneEvents}</a>
            <p class="mt-1 text-xs text-ink-faint">{t.pages.events.formNote}</p>
          </div>
        </div>

        <div data-reveal>
          <BookingForm client:load locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-[200] hidden items-center justify-center bg-ink/95 p-6" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button id="lightbox-close" type="button" class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label={t.ui.common.closeAria}>✕</button>
    <button id="lightbox-prev" type="button" class="absolute left-5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label={t.ui.common.prevPhotoAria}>‹</button>
    <div
      id="lightbox-spinner"
      class="pointer-events-none absolute hidden h-8 w-8 animate-spin rounded-full border-2 border-paper-raised/25 border-t-paper-raised"
      aria-hidden="true"
    ></div>
    <img id="lightbox-img" src="" alt="" class="max-h-[86vh] max-w-[92vw] object-contain" />
    <button id="lightbox-next" type="button" class="absolute right-5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label={t.ui.common.nextPhotoAria}>›</button>
  </div>

  <script>
    import { initReveal } from "@/lib/motion";
    initReveal();

    document.querySelectorAll<HTMLButtonElement>(".hall-prev, .hall-next").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.dataset.target;
        const dir = Number(btn.dataset.dir);
        const track = targetId ? document.getElementById(targetId) : null;
        if (!track) return;
        const img = track.querySelector("img");
        const step = img ? img.getBoundingClientRect().width : 320;
        track.scrollBy({ left: dir * step, behavior: "smooth" });
      });
    });

    const lightbox = document.getElementById("lightbox") as HTMLElement;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const lightboxSpinner = document.getElementById("lightbox-spinner") as HTMLElement;
    const closeBtn = document.getElementById("lightbox-close") as HTMLButtonElement;
    const prevBtn = document.getElementById("lightbox-prev") as HTMLButtonElement;
    const nextBtn = document.getElementById("lightbox-next") as HTMLButtonElement;

    const allPhotoBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".hall-photo"));
    let currentGroup: HTMLButtonElement[] = [];
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function setImage() {
      const btn = currentGroup[currentIndex];
      const fullSrc = btn.dataset.full ?? "";
      lightboxImg.alt = btn.getAttribute("aria-label") ?? "";
      lightboxSpinner.classList.toggle("hidden", lightboxImg.complete && lightboxImg.src === fullSrc);
      lightboxImg.src = fullSrc;
      [1, -1].forEach((d) => {
        const n = currentGroup[(currentIndex + d + currentGroup.length) % currentGroup.length];
        if (n) new Image().src = n.dataset.full ?? "";
      });
    }
    function openLightbox(btn: HTMLButtonElement) {
      currentGroup = allPhotoBtns.filter((b) => b.dataset.track === btn.dataset.track);
      currentIndex = currentGroup.indexOf(btn);
      lastFocused = btn;
      setImage();
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      closeBtn.focus();
    }
    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      lastFocused?.focus();
    }
    function step(delta: number) {
      currentIndex = (currentIndex + delta + currentGroup.length) % currentGroup.length;
      setImage();
    }

    lightboxImg.addEventListener("load", () => lightboxSpinner.classList.add("hidden"));
    lightboxImg.addEventListener("error", () => lightboxSpinner.classList.add("hidden"));

    allPhotoBtns.forEach((btn) => btn.addEventListener("click", () => openLightbox(btn)));
    closeBtn.addEventListener("click", closeLightbox);
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
      if (e.key === "Tab") {
        const focusables = [prevBtn, nextBtn, closeBtn];
        const idx = focusables.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        const next = e.shiftKey ? (idx <= 0 ? focusables.length - 1 : idx - 1) : idx === -1 || idx === focusables.length - 1 ? 0 : idx + 1;
        focusables[next].focus();
      }
    });
  </script>
</Layout>
