---
import Layout from "@/layouts/Layout.astro";
import HistoryCarousel from "@/components/HistoryCarousel.astro";
import { HISTORY } from "@/data/history";
import { getContent, localizedHref } from "@/lib/i18n";
import { breadcrumbSchema } from "@/lib/breadcrumbs";
import FaqSection from "@/components/FaqSection.astro";

const locale = "zh" as const;
const t = getContent(locale);

const faqItems = [
  {
    question: "「莱斯纳亚·扎伊姆卡」建于哪一年？与什么事件有关？",
    answer: "这座建筑建于1974年——1974年11月23日至24日，美国总统福特与苏联共产党中央委员会总书记勃列日涅夫在此举行了具有历史意义的符拉迪沃斯托克会晤庆祝接待仪式，双方为《第二阶段限制战略武器条约》（SALT II）奠定了基础。",
  },
  {
    question: "有哪些名人到访过「莱斯纳亚·扎伊姆卡」？",
    answer: "除福特与勃列日涅夫外，2002年朝鲜领导人金正日曾在此用早餐。符拉迪沃斯托克市长伊戈尔·谢尔盖耶维奇·普什卡廖夫，以及高尔基剧院艺术总监、俄罗斯联邦人民艺术家叶菲姆·兹韦尼亚茨基也曾到访本店。",
  },
  {
    question: "「莱斯纳亚·扎伊姆卡」的业主是谁？",
    answer: "自1999年起，业主为阿尔图尔·阿维季科维奇·马努基扬，他承诺传承并发扬这里已形成的传统。",
  },
  {
    question: "这座建筑一直是现在的样子吗？",
    answer: "不是——2012年至2015年间，建筑因老旧原木无法抵御滨海边疆区潮湿气候而被彻底重建，重建工程历时两年，2015年符拉迪沃斯托克市长亲自到访焕然一新的综合体。",
  },
];

// Переведённые записи хроники — тот же порядок/годы, что и HISTORY (канонический
// источник), только title/body заменены на перевод по индексу.
const entries = HISTORY.map((h, i) => ({
  ...h,
  title: t.data.history[i]?.title ?? h.title,
  body: t.data.history[i]?.body ?? h.body,
}));

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: t.ui.nav.home, url: new URL(localizedHref("/", locale), Astro.site).toString() },
      { name: t.pages.history.eyebrow, url: new URL(localizedHref("/history/", locale), Astro.site).toString() },
    ])
  : null;
---

<Layout title={t.pages.history.title} description={t.pages.history.description} image="/img/hero-index.webp" locale={locale} path="/history/">
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.history.eyebrow}</p>
      <h1 class="mt-4 max-w-[24ch] font-display text-3xl font-semibold leading-[1.02] text-ink md:text-5xl" data-reveal>
        {t.pages.history.h1}
      </h1>
      <p class="mt-5 max-w-[62ch] text-ink-soft md:text-lg" data-reveal>
        {t.pages.history.lead}
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <HistoryCarousel entries={entries} locale={locale} />
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-16 md:px-8 md:pb-24">
    <blockquote class="frame-gold max-w-2xl bg-paper-raised p-8" data-reveal>
      <p class="font-body text-xl italic leading-relaxed text-ink">«{t.data.ownerQuote.text}»</p>
      <footer class="mt-4 font-mono text-xs text-ink-faint">
        <span class="block font-body text-sm not-italic text-ink">{t.data.ownerQuote.author}</span>
        {t.data.ownerQuote.role}
      </footer>
    </blockquote>
  </section>

  <section class="border-t border-line bg-[var(--color-velvet-deep)] py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--color-gold)]" data-reveal>{t.pages.history.honoredEyebrow}</p>
      <h2 class="mt-3 max-w-[28ch] font-display text-2xl font-semibold text-paper-raised md:text-3xl" data-reveal>
        {t.pages.history.honoredH2}
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {t.data.guestQuotes.map((q) => (
          <blockquote class="frame-gold bg-transparent p-7" data-reveal>
            <p class="text-paper-raised">«{q.text}»</p>
            <footer class="mt-4 font-mono text-xs text-paper-sunk/70">
              <span class="block font-body text-sm not-italic text-[var(--color-gold)]">{q.author}</span>
              {q.role}
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-line py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <FaqSection heading="常见问题" items={faqItems} />
    </div>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    initReveal();
  </script>
</Layout>
