---
import Layout from "@/layouts/Layout.astro";
import { ZAIMKA_MENU } from "@/data/menu";
import { withBase } from "@/lib/url";
import { getContent, localizedHref } from "@/lib/i18n";
import { breadcrumbSchema } from "@/lib/breadcrumbs";
import FaqSection from "@/components/FaqSection.astro";

const locale = "zh" as const;
const t = getContent(locale);

const faqItems = [
  {
    question: "餐厅提供什么菜系？",
    answer: "俄罗斯菜、猎人菜、远东菜和高加索菜——从野味和远东海鲜到高加索烤肉串和恰恰布里。",
  },
  {
    question: "餐厅人均消费是多少？",
    answer: "根据餐厅在Яндекс地图和2ГИС的官方页面，人均消费为3500至5000卢布。",
  },
];

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: t.ui.nav.home, url: new URL(localizedHref("/", locale), Astro.site).toString() },
      { name: t.pages.menu.eyebrow, url: new URL(localizedHref("/menu/", locale), Astro.site).toString() },
    ])
  : null;

// Переведённые названия зафиксированы по ИНДЕКСУ категории/блюда — цены и
// порядок всегда берутся из канонического ZAIMKA_MENU (src/data/menu.ts),
// перевод меняет только отображаемый текст, не цифры.
const categories = ZAIMKA_MENU.categories.map((cat, idx) => ({
  ...cat,
  slug: `cat-${idx}`,
  displayName: t.data.menuCategories[idx]?.name ?? cat.name,
  items: cat.items.map((item, ii) => ({
    ...item,
    displayName: t.data.menuCategories[idx]?.items[ii] ?? item.name,
  })),
}));

const menuSchema = {
  "@context": "https://schema.org",
  "@type": "Menu",
  name: t.pages.menu.title,
  hasMenuSection: categories.map((cat) => ({
    "@type": "MenuSection",
    name: cat.displayName,
    hasMenuItem: cat.items.map((item) => ({
      "@type": "MenuItem",
      name: item.displayName,
      offers: {
        "@type": "Offer",
        price: item.price,
        priceCurrency: "RUB",
      },
    })),
  })),
};
---

<Layout title={t.pages.menu.title} description={t.pages.menu.description} image="/img/gallery/kitchen/full/1.webp" locale={locale} path="/menu/">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(menuSchema)} />
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-16">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>{t.pages.menu.eyebrow}</p>
      <h1 class="mt-4 font-display text-3xl font-semibold text-ink md:text-4xl" data-reveal>{t.pages.menu.h1}</h1>
      <p class="mt-4 max-w-[62ch] text-ink-soft" data-reveal>
        {t.pages.menu.lead}
      </p>
      <p class="mt-3 max-w-[62ch] font-mono text-xs text-ink-faint" data-reveal>
        {t.pages.menu.preorderNote}
      </p>
      <div class="mt-6 flex flex-wrap gap-3" data-reveal>
        <a
          href={withBase("/pdf/detskoe-menu.pdf")}
          target="_blank"
          rel="noopener"
          class="plaque inline-flex items-center gap-2 border border-[var(--color-burgundy)] px-4 py-2.5 font-mono text-[13px] tracking-wide text-[var(--color-burgundy)] transition-colors hover:bg-[var(--color-burgundy)] hover:text-paper-raised"
        >
          {t.pages.menu.kidsMenuBtn}
        </a>
        <a
          href={withBase("/pdf/bar-menu.pdf")}
          target="_blank"
          rel="noopener"
          class="plaque inline-flex items-center gap-2 border border-[var(--color-burgundy)] px-4 py-2.5 font-mono text-[13px] tracking-wide text-[var(--color-burgundy)] transition-colors hover:bg-[var(--color-burgundy)] hover:text-paper-raised"
        >
          {t.pages.menu.barMenuBtn}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[220px_1fr]">
      <nav class="top-24 flex flex-row flex-wrap gap-x-1 gap-y-1 self-start lg:sticky lg:flex-col lg:gap-0" aria-label="菜单分类">
        {categories.map((cat) => (
          <a
            href={`#${cat.slug}`}
            class="menu-cat-link border-b-2 border-transparent px-2 py-2 font-mono text-[13px] text-ink-soft lg:border-b-0 lg:border-l-2 lg:pl-3"
            data-slug={cat.slug}
          >
            {cat.displayName}
          </a>
        ))}
      </nav>

      <div>
        {categories.map((cat, idx) => (
          <div id={cat.slug} class="menu-cat scroll-mt-24 pt-6" data-reveal>
            <h2 class="font-display text-2xl font-semibold text-ink">{cat.displayName}</h2>
            <div class="mt-5 divide-y divide-dashed divide-line">
              {cat.items.map((item) => (
                <div class="flex items-center justify-between gap-4 py-3.5">
                  <span class="text-ink">{item.displayName}</span>
                  <span class="flex shrink-0 items-center gap-3">
                    <span class="font-mono text-sm text-brass">{item.price.toLocaleString("ru-RU")} ₽</span>
                    <button
                      type="button"
                      data-add-item
                      data-name={item.name}
                      data-price={item.price}
                      aria-label={t.pages.menu.addItemAria.replace("{name}", item.displayName)}
                      class="flex h-9 w-9 shrink-0 items-center justify-center border border-line text-ink-soft transition-colors hover:border-ink hover:bg-ink hover:text-paper-raised"
                    >
                      +
                    </button>
                  </span>
                </div>
              ))}
            </div>
            {idx < categories.length - 1 && <div class="mt-10 border-t border-line"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper-sunk/40 py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <FaqSection heading="常见问题" items={faqItems} />
    </div>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    import { addToCart } from "@/lib/cart";
    initReveal();

    // Корзина/WhatsApp-сообщение (src/lib/cart.ts, CartDrawer.astro) работает
    // с data-name — оставляем там РЕАЛЬНОЕ русское название блюда (то, что
    // поймёт кухня/менеджер), а на кнопке гость видит переведённый displayName.
    document.querySelectorAll<HTMLButtonElement>("[data-add-item]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const name = btn.dataset.name;
        const price = Number(btn.dataset.price);
        if (!name || !Number.isFinite(price)) return;
        addToCart(name, price);
        const original = btn.textContent;
        btn.textContent = "✓";
        btn.classList.add("border-ink", "bg-ink", "text-paper-raised");
        window.setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove("border-ink", "bg-ink", "text-paper-raised");
        }, 700);
      });
    });

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".menu-cat-link"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>(".menu-cat"));
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const idx = sections.indexOf(entry.target as HTMLElement);
            if (entry.isIntersecting && idx > -1) {
              links.forEach((l) => l.classList.remove("text-brass", "border-brass"));
              links[idx]?.classList.add("text-brass", "border-brass");
            }
          });
        },
        { rootMargin: "-20% 0px -70% 0px" }
      );
      sections.forEach((s) => io.observe(s));
    }
  </script>
</Layout>
