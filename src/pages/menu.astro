---
import Layout from "@/layouts/Layout.astro";
import { ZAIMKA_MENU } from "@/data/menu";
import { withBase } from "@/lib/url";
import { breadcrumbSchema } from "@/lib/breadcrumbs";
import FaqSection from "@/components/FaqSection.astro";

const faqItems = [
  {
    question: "Какая кухня в ресторане «Лесная Заимка»?",
    answer: "Русская, охотничья, дальневосточная и кавказская кухня. В меню — строганина из оленины, ассорти дальневосточных морепродуктов (краб, гребешок, трубач, лососёвая икра), оленина по-охотничьи и кавказские блюда.",
  },
  {
    question: "Сколько блюд в меню ресторана?",
    answer: "13 разделов меню и 139 блюд — от холодных закусок до горячего из дичи и морепродуктов.",
  },
  {
    question: "Какой средний чек в ресторане?",
    answer: "Средний чек — от 3500 до 5000 ₽ на человека, по данным Яндекс.Карт и 2ГИС.",
  },
];

const categories = ZAIMKA_MENU.categories.map((cat, idx) => ({ ...cat, slug: `cat-${idx}` }));

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: "Главная", url: new URL(withBase("/"), Astro.site).toString() },
      { name: "Меню ресторана", url: new URL(withBase("/menu/"), Astro.site).toString() },
    ])
  : null;

// Schema.org Menu — реальные разделы и блюда, без выдуманных описаний/ингредиентов
// (правило ТЗ: факты только из источника; у нас есть только name+price).
const menuSchema = {
  "@context": "https://schema.org",
  "@type": "Menu",
  name: "Меню ресторана «Лесная Заимка»",
  hasMenuSection: ZAIMKA_MENU.categories.map((cat) => ({
    "@type": "MenuSection",
    name: cat.name,
    hasMenuItem: cat.items.map((item) => ({
      "@type": "MenuItem",
      name: item.name,
      offers: {
        "@type": "Offer",
        price: item.price,
        priceCurrency: "RUB",
      },
    })),
  })),
};
---

<Layout
  title="Меню — Лесная Заимка, Владивосток"
  description="Полное меню ресторана «Лесная Заимка»: холодные закуски, дичь, дальневосточная и кавказская кухня, банкетное и фуршетное меню. 13 разделов, реальные цены."
  image="/img/halls/osnovnoy/full/1.webp"
  path="/menu/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(menuSchema)} />
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-16">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>Меню ресторана</p>
      <h1 class="mt-4 font-display text-3xl font-semibold text-ink md:text-4xl" data-reveal>Традиции щедрого стола</h1>
      <p class="mt-4 max-w-[62ch] text-ink-soft" data-reveal>
        13 разделов, больше сотни блюд русской, охотничьей, дальневосточной и кавказской кухни.
      </p>
      <p class="mt-3 max-w-[62ch] font-mono text-xs text-ink-faint" data-reveal>
        Нет времени приехать — соберите предзаказ кнопкой «+» у блюда и выберите «Доставка» в корзине.
      </p>
      <div class="mt-6 flex flex-wrap gap-3" data-reveal>
        <a
          href={withBase("/pdf/detskoe-menu.pdf")}
          target="_blank"
          rel="noopener"
          class="plaque inline-flex items-center gap-2 border border-[var(--color-burgundy)] px-4 py-2.5 font-mono text-[13px] tracking-wide text-[var(--color-burgundy)] transition-colors hover:bg-[var(--color-burgundy)] hover:text-paper-raised"
        >
          Детское меню (PDF) →
        </a>
        <a
          href={withBase("/pdf/bar-menu.pdf")}
          target="_blank"
          rel="noopener"
          class="plaque inline-flex items-center gap-2 border border-[var(--color-burgundy)] px-4 py-2.5 font-mono text-[13px] tracking-wide text-[var(--color-burgundy)] transition-colors hover:bg-[var(--color-burgundy)] hover:text-paper-raised"
        >
          Карта бара (PDF) →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 md:px-8 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[220px_1fr]">
      <nav class="top-24 flex flex-row flex-wrap gap-x-1 gap-y-1 self-start lg:sticky lg:flex-col lg:gap-0" aria-label="Категории меню">
        {categories.map((cat) => (
          <a
            href={`#${cat.slug}`}
            class="menu-cat-link border-b-2 border-transparent px-2 py-2 font-mono text-[13px] text-ink-soft lg:border-b-0 lg:border-l-2 lg:pl-3"
            data-slug={cat.slug}
          >
            {cat.name}
          </a>
        ))}
      </nav>

      <div>
        {categories.map((cat, idx) => (
          <div id={cat.slug} class="menu-cat scroll-mt-24 pt-6" data-reveal>
            <h2 class="font-display text-2xl font-semibold text-ink">{cat.name}</h2>
            <div class="mt-5 divide-y divide-dashed divide-line">
              {cat.items.map((item) => (
                <div class="flex items-center justify-between gap-4 py-3.5">
                  <span class="text-ink">{item.name}</span>
                  <span class="flex shrink-0 items-center gap-3">
                    <span class="font-mono text-sm text-brass">{item.price.toLocaleString("ru-RU")} ₽</span>
                    <button
                      type="button"
                      data-add-item
                      data-name={item.name}
                      data-price={item.price}
                      aria-label={`Добавить «${item.name}» в предзаказ`}
                      class="flex h-9 w-9 shrink-0 items-center justify-center border border-line text-ink-soft transition-colors hover:border-ink hover:bg-ink hover:text-paper-raised"
                    >
                      +
                    </button>
                  </span>
                </div>
              ))}
            </div>
            {idx < categories.length - 1 && <div class="mt-10 border-t border-line"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper-sunk/40 py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <FaqSection heading="Частые вопросы" items={faqItems} />
    </div>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    import { addToCart } from "@/lib/cart";
    initReveal();

    document.querySelectorAll<HTMLButtonElement>("[data-add-item]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const name = btn.dataset.name;
        const price = Number(btn.dataset.price);
        if (!name || !Number.isFinite(price)) return;
        addToCart(name, price);
        const original = btn.textContent;
        btn.textContent = "✓";
        btn.classList.add("border-ink", "bg-ink", "text-paper-raised");
        window.setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove("border-ink", "bg-ink", "text-paper-raised");
        }, 700);
      });
    });

    // Подсветка активной категории при скролле — тот же паттерн, что применялся
    // в предыдущих версиях сайта этого ресторана и уже проверен в этой сессии.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".menu-cat-link"));
    const sections = Array.from(document.querySelectorAll<HTMLElement>(".menu-cat"));
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const idx = sections.indexOf(entry.target as HTMLElement);
            if (entry.isIntersecting && idx > -1) {
              links.forEach((l) => l.classList.remove("text-brass", "border-brass"));
              links[idx]?.classList.add("text-brass", "border-brass");
            }
          });
        },
        { rootMargin: "-20% 0px -70% 0px" }
      );
      sections.forEach((s) => io.observe(s));
    }
  </script>
</Layout>
