---
import Layout from "@/layouts/Layout.astro";
import { HALLS, EVENT_FORMATS } from "@/data/halls";
import { CONTACTS } from "@/data/contacts";
import BookingForm from "@/components/BookingForm";
---

<Layout
  title="Мероприятия и банкеты — Лесная Заимка, Владивосток"
  description="6 залов от 30 до 500 гостей: свадьбы, банкеты, корпоративы, фуршеты, кейтеринг и выезд шеф-повара в ресторанном комплексе «Лесная Заимка». Оставьте заявку с датой и числом гостей."
>
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>Мероприятия и залы</p>
      <h1 class="mt-4 max-w-[22ch] font-display text-3xl font-semibold leading-[1.02] text-ink md:text-5xl" data-reveal>
        Шесть залов — от камерного ужина до приёма на 500 гостей
      </h1>
      <p class="mt-5 max-w-[62ch] text-ink-soft md:text-lg" data-reveal>
        Свадьбы, банкеты, корпоративные приёмы, кейтеринг и выезд шеф-повара, доставка блюд.
        Цифры ниже — единственный официальный источник: раздел аренды залов сайта-источника.
      </p>
      <div class="mt-6 flex flex-wrap gap-2" data-reveal>
        {EVENT_FORMATS.map((f) => (
          <span class="border border-line bg-paper-raised px-3 py-1.5 font-mono text-xs text-ink-soft">{f}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {HALLS.map((hall) => (
        <article class="flex flex-col bg-paper-raised" data-reveal>
          <div class="aspect-[4/3] overflow-hidden bg-paper-sunk">
            <img src={hall.image} alt={hall.name} loading="lazy" class="h-full w-full object-cover" />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h2 class="font-display text-lg font-semibold text-ink">{hall.name}</h2>
            <p class="mt-2 flex-1 text-sm text-ink-soft">{hall.description}</p>
            <div class="mt-4 flex items-center justify-between border-t border-line pt-4 font-mono text-xs">
              <span class="text-ink-faint">Вместимость</span>
              <span class="text-brass">{hall.capacity}</span>
            </div>
            {hall.area && (
              <div class="mt-2 flex items-center justify-between font-mono text-xs">
                <span class="text-ink-faint">Площадь</span>
                <span class="text-brass">{hall.area}</span>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="form" class="border-t border-line bg-paper-sunk/40 scroll-mt-20">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr]">
        <div data-reveal>
          <p class="font-mono text-xs uppercase tracking-wide text-brass">Заявка на мероприятие</p>
          <h2 class="mt-3 font-display text-2xl font-semibold text-ink md:text-3xl">
            Расскажите о вашем событии
          </h2>
          <p class="mt-4 max-w-[46ch] text-ink-soft">
            Укажите дату и число гостей — банкетный отдел подберёт зал и вернётся с расчётом.
          </p>
          <div class="mt-8 border-t border-line pt-6">
            <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">Банкетный отдел</p>
            <a href={CONTACTS.phoneEventsHref} class="mt-2 block font-display text-xl text-ink">{CONTACTS.phoneEvents}</a>
            <a href={CONTACTS.whatsapp} target="_blank" rel="noopener" class="mt-1 block font-mono text-sm text-brass">Написать в WhatsApp</a>
          </div>
        </div>

        <div data-reveal>
          <BookingForm client:load />
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    initReveal();
  </script>
</Layout>
