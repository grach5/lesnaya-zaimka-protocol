---
import Layout from "@/layouts/Layout.astro";
import { HALLS, EVENT_FORMATS } from "@/data/halls";
import { CONTACTS } from "@/data/contacts";
import { withBase } from "@/lib/url";
import BookingForm from "@/components/BookingForm";
import HallCarousel from "@/components/HallCarousel.astro";
---

<Layout
  title="Банкетный комплекс — Лесная Заимка, Владивосток"
  description="6 залов от 30 до 500 гостей: свадьбы, банкеты, корпоративы, фуршеты, кейтеринг и выезд шеф-повара в ресторанном комплексе «Лесная Заимка». Оставьте заявку с датой и числом гостей."
  image="/img/halls/osnovnoy/1.webp"
>
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>Банкетный комплекс</p>
      <h1 class="mt-4 max-w-[22ch] font-display text-3xl font-semibold leading-[1.02] text-ink md:text-5xl" data-reveal>
        Шесть залов — от камерного ужина до приёма на 500 гостей
      </h1>
      <p class="mt-5 max-w-[62ch] text-ink-soft md:text-lg" data-reveal>
        Свадьбы, банкеты, корпоративные приёмы, кейтеринг и выезд шеф-повара, доставка блюд.
      </p>
      <div class="mt-6 flex flex-wrap gap-2" data-reveal>
        {EVENT_FORMATS.map((f) => (
          <span class="border border-line bg-paper-raised px-3 py-1.5 font-mono text-xs text-ink-soft">{f}</span>
        ))}
      </div>
      <a
        href={withBase("/pdf/banketnoe-menu.pdf")}
        target="_blank"
        rel="noopener"
        class="plaque mt-6 inline-flex items-center gap-2 bg-[var(--color-burgundy)] px-5 py-3 font-mono text-[13px] tracking-wide text-paper-raised transition-colors hover:bg-[var(--color-gold)] hover:text-ink"
      >
        Открыть банкетное меню (PDF) →
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
    <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>Аренда залов</p>
    <h2 class="mt-3 max-w-[30ch] font-display text-2xl font-semibold text-ink md:text-3xl" data-reveal>
      Листайте и открывайте фото каждого зала
    </h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {HALLS.map((hall, i) => (
        <HallCarousel hall={hall} index={i} />
      ))}
    </div>
  </section>

  <section id="form" class="border-t border-line bg-paper-sunk/40 scroll-mt-20">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr]">
        <div data-reveal>
          <p class="font-mono text-xs uppercase tracking-wide text-brass">Заявка на мероприятие</p>
          <h2 class="mt-3 font-display text-2xl font-semibold text-ink md:text-3xl">
            Расскажите о вашем событии
          </h2>
          <p class="mt-4 max-w-[46ch] text-ink-soft">
            Укажите дату и число гостей — банкетный отдел подберёт зал и вернётся с расчётом.
          </p>
          <div class="mt-8 border-t border-line pt-6">
            <p class="font-mono text-xs uppercase tracking-wide text-ink-faint">Банкетный отдел</p>
            <a href={CONTACTS.phoneEventsHref} class="mt-2 block font-display text-xl text-ink">{CONTACTS.phoneEvents}</a>
            <p class="mt-1 text-xs text-ink-faint">Или заполните форму — заявка уйдёт в WhatsApp с пометкой «мероприятие»</p>
          </div>
        </div>

        <div data-reveal>
          <BookingForm client:load />
        </div>
      </div>
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-[200] hidden items-center justify-center bg-ink/95 p-6" role="dialog" aria-modal="true" aria-label="Просмотр фотографии">
    <button id="lightbox-close" type="button" class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label="Закрыть">✕</button>
    <button id="lightbox-prev" type="button" class="absolute left-5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label="Предыдущее фото">‹</button>
    <img id="lightbox-img" src="" alt="" class="max-h-[86vh] max-w-[92vw] object-contain" />
    <button id="lightbox-next" type="button" class="absolute right-5 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center border border-paper-raised/30 text-paper-raised" aria-label="Следующее фото">›</button>
  </div>

  <script>
    import { initReveal } from "@/lib/motion";
    initReveal();

    document.querySelectorAll<HTMLButtonElement>(".hall-prev, .hall-next").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.dataset.target;
        const dir = Number(btn.dataset.dir);
        const track = targetId ? document.getElementById(targetId) : null;
        if (!track) return;
        const img = track.querySelector("img");
        const step = img ? img.getBoundingClientRect().width : 320;
        track.scrollBy({ left: dir * step, behavior: "smooth" });
      });
    });

    // Лайтбокс для фото залов — тот же паттерн, что и в /gallery/, но группа
    // prev/next ограничена фотографиями ОДНОГО зала (data-track), а не всех сразу.
    const lightbox = document.getElementById("lightbox") as HTMLElement;
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
    const closeBtn = document.getElementById("lightbox-close") as HTMLButtonElement;
    const prevBtn = document.getElementById("lightbox-prev") as HTMLButtonElement;
    const nextBtn = document.getElementById("lightbox-next") as HTMLButtonElement;

    const allPhotoBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".hall-photo"));
    let currentGroup: HTMLButtonElement[] = [];
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    function setImage() {
      const btn = currentGroup[currentIndex];
      lightboxImg.src = btn.dataset.full ?? "";
      lightboxImg.alt = btn.getAttribute("aria-label") ?? "";
    }
    function openLightbox(btn: HTMLButtonElement) {
      currentGroup = allPhotoBtns.filter((b) => b.dataset.track === btn.dataset.track);
      currentIndex = currentGroup.indexOf(btn);
      lastFocused = btn;
      setImage();
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      closeBtn.focus();
    }
    function closeLightbox() {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      lastFocused?.focus();
    }
    function step(delta: number) {
      currentIndex = (currentIndex + delta + currentGroup.length) % currentGroup.length;
      setImage();
    }

    allPhotoBtns.forEach((btn) => btn.addEventListener("click", () => openLightbox(btn)));
    closeBtn.addEventListener("click", closeLightbox);
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (lightbox.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
      if (e.key === "Tab") {
        const focusables = [prevBtn, nextBtn, closeBtn];
        const idx = focusables.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        const next = e.shiftKey ? (idx <= 0 ? focusables.length - 1 : idx - 1) : idx === -1 || idx === focusables.length - 1 ? 0 : idx + 1;
        focusables[next].focus();
      }
    });
  </script>
</Layout>
