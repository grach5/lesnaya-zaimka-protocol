---
import Layout from "@/layouts/Layout.astro";
import HistoryCarousel from "@/components/HistoryCarousel.astro";
import { HISTORY, OWNER_QUOTE, GUEST_QUOTES } from "@/data/history";
import { withBase } from "@/lib/url";
import { breadcrumbSchema } from "@/lib/breadcrumbs";
import FaqSection from "@/components/FaqSection.astro";

const faqItems = [
  {
    question: "Когда построен дом «Лесная Заимка» и с каким событием он связан?",
    answer: "Дом построен в 1974 году — здесь прошёл торжественный приём в честь исторической Владивостокской встречи 23–24 ноября 1974 года, где президент США Джеральд Форд и генеральный секретарь ЦК КПСС Леонид Брежнев заложили основу договора ОСВ-2 об ограничении стратегических вооружений.",
  },
  {
    question: "Кто из известных людей бывал в «Лесной Заимке»?",
    answer: "Помимо Форда и Брежнева, в 2002 году здесь завтракал лидер КНДР Ким Чен Ир. Дом также посещали мэр Владивостока Игорь Пушкарёв и народный артист РФ Ефим Звеняцкий, художественный руководитель Театра им. М. Горького.",
  },
  {
    question: "Кто владелец ресторана «Лесная Заимка»?",
    answer: "С 1999 года владелец — Артур Аветикович Манукян, взявший на себя обязательство сохранить и приумножить традиции дома.",
  },
  {
    question: "Дом всегда выглядел так, как сейчас?",
    answer: "Нет — в 2012–2015 годах здание отстроили заново: старые брёвна не выдержали влажного приморского климата. Реконструкция заняла два года, а в 2015 году обновлённый комплекс лично посетил глава Владивостока.",
  },
];

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: "Главная", url: new URL(withBase("/"), Astro.site).toString() },
      { name: "Хронология дома", url: new URL(withBase("/history/"), Astro.site).toString() },
    ])
  : null;
---

<Layout
  title="История — Лесная Заимка, дом с 1974 года"
  description="Полная хронология ресторанного комплекса «Лесная Заимка» во Владивостоке: приём Форда и Брежнева в 1974-м, завтрак Ким Чен Ира в 2002-м."
  image="/img/hero-index.webp"
  path="/history/"
>
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-20">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>Хронология дома</p>
      <h1 class="mt-4 max-w-[24ch] font-display text-3xl font-semibold leading-[1.02] text-ink md:text-5xl" data-reveal>
        Полвека истории в одном доме
      </h1>
      <p class="mt-5 max-w-[62ch] text-ink-soft md:text-lg" data-reveal>
        Дом строили в 1974 году к приезду глав двух держав — и с тех пор он не переставал принимать
        гостей, о которых потом рассказывают десятилетиями. Каждая запись ниже — подтверждённый факт,
        а не легенда.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <HistoryCarousel entries={HISTORY} />
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-16 md:px-8 md:pb-24">
    <blockquote class="frame-gold max-w-2xl bg-paper-raised p-8" data-reveal>
      {/* font-body, не font-display: у Podkova (дисплейный шрифт) нет курсивного
         начертания вообще — браузер рисовал бы синтетический наклон вместо
         настоящих курсивных литер. PT Serif курсив импортирован отдельно
         именно под эту цитату (cyrillic-400-italic в global.css). */}
      <p class="font-body text-xl italic leading-relaxed text-ink">«{OWNER_QUOTE.text}»</p>
      <footer class="mt-4 font-mono text-xs text-ink-faint">
        <span class="block font-body text-sm not-italic text-ink">{OWNER_QUOTE.author}</span>
        {OWNER_QUOTE.role}
      </footer>
    </blockquote>
  </section>

  <section class="border-t border-line bg-[var(--color-velvet-deep)] py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5 md:px-8">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--color-gold)]" data-reveal>Почётные гости</p>
      <h2 class="mt-3 max-w-[28ch] font-display text-2xl font-semibold text-paper-raised md:text-3xl" data-reveal>
        О доме говорят те, кому есть с чем сравнивать
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {GUEST_QUOTES.map((q) => (
          <blockquote class="frame-gold bg-transparent p-7" data-reveal>
            <p class="text-paper-raised">«{q.text}»</p>
            <footer class="mt-4 font-mono text-xs text-paper-sunk/70">
              <span class="block font-body text-sm not-italic text-[var(--color-gold)]">{q.author}</span>
              {q.role}
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-line py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <FaqSection heading="Частые вопросы" items={faqItems} />
    </div>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    initReveal();
  </script>
</Layout>
