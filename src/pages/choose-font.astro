    <style>
      :root {
        --paper: #F6F1E4; --paper-raised: #FFFDF8; --ink: #1E140F; --ink-soft: #4A3B30;
        --ink-faint: #6B5C4E; --gold: #B8902E; --gold-bright: #D4AF37; --burgundy: #812824; --line: rgba(30,20,15,0.14);
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--paper); color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      .shell { max-width: 1040px; margin: 0 auto; padding: 28px 20px 80px; }
    
      .toolbar {
        position: sticky; top: 0; z-index: 5; background: var(--paper);
        padding: 10px 0; margin-bottom: 6px; border-bottom: 1px solid var(--line);
        display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between;
      }
      .toolbar input[type="search"] {
        flex: 1 1 240px; min-width: 0; height: 40px; padding: 0 14px; font-size: 14px;
        border: 1px solid var(--line); background: var(--paper-raised); color: var(--ink); font-family: inherit;
      }
      .toolbar input[type="search"]:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 1px; }
      .toolbar .picked { font-size: 13px; color: var(--ink-soft); white-space: nowrap; display: flex; align-items: center; gap: 8px; }
      .toolbar .picked strong { color: var(--burgundy); font-variant-numeric: tabular-nums; }
      .toolbar button.clear {
        font: inherit; font-size: 12px; color: var(--ink-faint); background: none; border: 1px solid var(--line);
        padding: 6px 10px; cursor: pointer;
      }
      .toolbar button.clear:hover { color: var(--burgundy); border-color: var(--burgundy); }
    
      .group { margin-top: 22px; }
      .group h2 {
        margin: 0 0 10px; font-size: 15px; font-weight: 700;
      }
      .group h2 .count { font-size: 12px; font-weight: 400; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
    
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 10px; }
      .card {
        position: relative; text-align: left; cursor: pointer;
        background: var(--paper-raised); border: 1px solid var(--line);
        padding: 14px 14px 16px; font: inherit; color: inherit;
        display: flex; flex-direction: column; gap: 8px;
        transition: border-color .12s ease, box-shadow .12s ease;
      }
      .card:hover { border-color: var(--gold); }
      .card:focus-visible { outline: 2px solid var(--gold-bright); outline-offset: 2px; }
      .card[aria-pressed="true"] {
        border-color: var(--gold-bright); box-shadow: 0 0 0 1px var(--gold-bright) inset; background: #FFFCF3;
      }
      .card .star { position: absolute; top: 10px; right: 10px; font-size: 14px; color: var(--line); line-height: 1; }
      .card[aria-pressed="true"] .star { color: var(--gold-bright); }
      .card .fname {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 11px; font-weight: 600; letter-spacing: 0.02em; color: var(--ink-faint); padding-right: 20px;
      }
      .card .sample { font-size: 21px; line-height: 1.22; color: var(--ink); text-wrap: balance; }
      .card.is-hidden { display: none; }
      .group.is-empty { display: none; }
    </style>
    
