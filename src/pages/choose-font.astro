      <footer class="note">
        Отметки сохраняются в этой вкладке (localStorage) — переживут обновление страницы, но не путешествуют между устройствами. Шрифты подключены напрямую с Google Fonts (единственный внешний хост, разрешённый для артефактов) — реальные файлы, не подделка. Скажите, какие номера/названия приглянулись клиенту — включу выбранную пару на весь сайт и, как обычно, проверю вживую до и после деплоя.
      </footer>
    </div>
    <script>
    (function() {
      const STORAGE_KEY = 'zaimka-font-picks';
      let picks: Record<string, boolean> = {};
      try { picks = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch (e) {}

      const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.card'));
      const countEl = document.getElementById('picked-count');

      function updateCount() {
        if (countEl) countEl.textContent = String(Object.keys(picks).filter((k) => picks[k]).length);
      }
      function applyPicks() {
        cards.forEach((c) => {
          const on = !!picks[c.dataset.slug ?? ''];
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        updateCount();
      }
      function persist() {
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(picks)); } catch (e) {}
      }

      cards.forEach((c) => {
        c.addEventListener('click', () => {
          const key = c.dataset.slug ?? '';
          picks[key] = !picks[key];
          if (!picks[key]) delete picks[key];
          c.setAttribute('aria-pressed', picks[key] ? 'true' : 'false');
          updateCount();
          persist();
        });
      });

      document.getElementById('clear-btn')?.addEventListener('click', () => {
        picks = {};
        persist();
        applyPicks();
      });

      const searchInput = document.getElementById('search') as HTMLInputElement | null;
      const emptyNote = document.getElementById('empty-note');
      searchInput?.addEventListener('input', () => {
        const q = searchInput.value.trim().toLowerCase();
        let anyVisible = false;
        document.querySelectorAll<HTMLElement>('.group').forEach((group) => {
          let groupHasMatch = false;
          group.querySelectorAll<HTMLButtonElement>('.card').forEach((c) => {
            const match = !q || (c.dataset.name ?? '').toLowerCase().indexOf(q) > -1;
            c.classList.toggle('is-hidden', !match);
            if (match) { groupHasMatch = true; anyVisible = true; }
          });
          group.style.display = (q && !groupHasMatch) ? 'none' : '';
          if (q && groupHasMatch) group.classList.remove('is-collapsed');
        });
        emptyNote?.classList.toggle('show', q.length > 0 && !anyVisible);
      });

      document.querySelectorAll<HTMLButtonElement>('.group-head').forEach((btn) => {
        btn.addEventListener('click', () => {
          const group = document.getElementById(btn.dataset.target ?? '');
          const collapsed = group?.classList.toggle('is-collapsed');
          const chev = btn.querySelector('.chev');
          if (chev) chev.innerHTML = collapsed ? '&#9656;' : '&#9662;';
        });
      });

      applyPicks();
    })();
    </script>
    
