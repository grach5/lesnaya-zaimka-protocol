---
import Layout from "@/layouts/Layout.astro";
import { CONTACTS } from "@/data/contacts";
import ReserveForm from "@/components/ReserveForm";
import { MAP_IMAGE_PATH, mapRouteUrl } from "@/lib/map";
import { withBase } from "@/lib/url";
import { breadcrumbSchema } from "@/lib/breadcrumbs";
import FaqSection from "@/components/FaqSection.astro";

const faqItems = [
  {
    question: "Где находится ресторан «Лесная Заимка» и как до него добраться?",
    answer: "Ресторан находится по адресу г. Владивосток, ул. Маковского, 290, на въезде в город. Точный маршрут можно построить в Яндекс.Картах — кнопка есть на этой странице.",
  },
  {
    question: "Часы работы ресторана «Лесная Заимка»?",
    answer: "Ресторан работает без выходных, с 11:00 до 00:00.",
  },
  {
    question: "Какие удобства есть в ресторане?",
    answer: "Собственная парковка, бесплатный Wi-Fi, летняя веранда, оплата картой, доставка блюд и еда навынос — по данным карточки заведения на Яндекс.Картах и 2ГИС.",
  },
  {
    question: "Какой рейтинг у ресторана «Лесная Заимка» и есть ли награды?",
    answer: "4,7 из 5 на Яндекс.Картах (984 оценки, награда «Хорошее место 2026») и 4,9 из 5 на 2ГИС (503 оценки, номинант премии 2ГИС 2026 года).",
  },
  {
    question: "Играет ли в ресторане живая музыка?",
    answer: "Да, живая музыка звучит с четверга по воскресенье.",
  },
  {
    question: "Есть ли рядом с рестораном гостиница?",
    answer: "Да, рядом находится гостиница и сауна Villa ArtE.",
  },
];

const mapImgSrc = withBase(MAP_IMAGE_PATH);
const routeUrl = mapRouteUrl(CONTACTS.lat, CONTACTS.lon);
const logoUrl = withBase("/img/brand/logo.png");

const breadcrumbs = Astro.site
  ? breadcrumbSchema([
      { name: "Главная", url: new URL(withBase("/"), Astro.site).toString() },
      { name: "Контакты", url: new URL(withBase("/contacts/"), Astro.site).toString() },
    ])
  : null;
---

<Layout
  title="Контакты и бронь стола — Лесная Заимка, Владивосток"
  description="Адрес, телефоны и часы работы ресторана «Лесная Заимка» во Владивостоке. Бронирование стола онлайн."
  image="/img/hero-video-poster.webp"
  path="/contacts/"
>
  {breadcrumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />}
  <section class="border-b border-line bg-paper-sunk/40">
    <div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-16">
      <p class="font-mono text-xs uppercase tracking-wide text-brass" data-reveal>Контакты</p>
      <h1 class="mt-4 font-display text-3xl font-semibold text-ink md:text-4xl" data-reveal>Забронировать стол</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <div class="border-t border-line">
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">Адрес</span>
            <span class="text-right text-ink">{CONTACTS.address}</span>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">Бронирование столов</span>
            <a href={CONTACTS.phoneTableHref} class="text-right text-brass">{CONTACTS.phoneTable}</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">Банкеты и мероприятия</span>
            <a href={CONTACTS.phoneEventsHref} class="text-right text-brass">{CONTACTS.phoneEvents}</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">WhatsApp</span>
            <a href={CONTACTS.whatsapp} target="_blank" rel="noopener" class="text-right text-brass">Написать в WhatsApp</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">Telegram</span>
            <a href={CONTACTS.telegram} target="_blank" rel="noopener" class="text-right text-brass">Написать в Telegram</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">MAX</span>
            <a href={CONTACTS.maxMessenger} target="_blank" rel="noopener" class="text-right text-brass">Написать в MAX</a>
          </div>
          <div class="flex items-start justify-between gap-6 border-b border-line py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">Часы работы</span>
            <span class="text-right text-ink">{CONTACTS.hours}</span>
          </div>
          <div class="flex items-start justify-between gap-6 py-4">
            <span class="font-mono text-xs uppercase tracking-wide text-ink-faint">Рядом</span>
            <span class="text-right text-ink">
              Гостиница и сауна <a href={CONTACTS.hotel.url} target="_blank" rel="noopener" class="text-brass underline underline-offset-2">{CONTACTS.hotel.name}</a>
            </span>
          </div>
        </div>
      </div>

      <div data-reveal>
        <h2 class="font-display text-xl font-semibold text-ink">Бронь стола</h2>
        <p class="mt-2 text-sm text-ink-soft">Оставьте имя и телефон — перезвоним и подтвердим бронь.</p>
        <div class="mt-6">
          <ReserveForm client:load />
        </div>
      </div>
    </div>

    {/* max-w-[700px]: источник статичной картинки — максимум 650px в ширину
       (см. lib/map.ts, бесплатный Static Maps API без ключа). На всю ширину
       секции (~1150px) она растягивалась почти в 1.8 раза и выглядела
       размыто — с этим ограничением растяжение минимальное, картинка резкая.
       Если в админке указан yandexMapsApiKey — поверх поднимается настоящая
       интерактивная карта (lib/yandexMap.ts), которая рисуется под реальный
       размер контейнера и резкая при любой ширине; тогда это ограничение
       можно будет снять. */}
    <div class="mt-16 max-w-[700px]" data-reveal>
      {/* data-yandex-map: если в админке задан ключ JS API — сюда поднимется
         интерактивная карта (см. lib/yandexMap.ts), а статичная картинка ниже
         скроется. Без ключа (или если скрипт не загрузился) остаётся она —
         тот же надёжный фолбэк, что был и раньше. */}
      <div
        class="relative h-[340px] w-full overflow-hidden border border-line md:h-[440px]"
        data-yandex-map
        data-lat={CONTACTS.lat}
        data-lon={CONTACTS.lon}
        data-zoom="17"
        data-api-key={CONTACTS.yandexMapsApiKey}
        data-logo={logoUrl}
        data-route={routeUrl}
      >
        <a
          href={routeUrl}
          target="_blank"
          rel="noopener"
          class="absolute inset-0 block"
          aria-label="Открыть карту с расположением «Лесная Заимка» в Яндекс.Картах"
          data-map-fallback
        >
          {/* Без loading="lazy": картинка внутри [data-reveal] (родитель скрыт через
             visibility:hidden до скролла) — нативный lazy-load иногда не срабатывает
             для контента внутри изначально невидимого предка и виснет навсегда. */}
          <img src={mapImgSrc} alt="Карта — «Лесная Заимка», ул. Маковского, 290" class="h-full w-full object-cover" />
          {/* Свой маркер вместо стандартной красной метки Яндекса — ll и есть нужная
             точка, а object-cover всегда центрирует картинку, поэтому центр
             контейнера = нужная точка независимо от его пропорций. Якорь —
             translate-y-full поднимает блок так, что нижний край (носик
             указателя) упирается ровно в эту точку, как у обычного пина. */}
          <span class="pointer-events-none absolute left-1/2 top-1/2 flex w-32 -translate-x-1/2 -translate-y-full flex-col items-center">
            <img src={logoUrl} alt="" class="h-auto w-full drop-shadow-[0_2px_6px_rgba(0,0,0,0.55)]" />
            <span class="h-0 w-0 border-x-[7px] border-x-transparent border-t-[11px] border-t-[var(--color-burgundy)] drop-shadow-[0_1px_2px_rgba(0,0,0,0.35)]"></span>
          </span>
        </a>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={routeUrl}
          target="_blank"
          rel="noopener"
          class="plaque inline-flex items-center gap-2 bg-[var(--color-burgundy)] px-5 py-3 font-mono text-[13px] tracking-wide text-paper-raised transition-colors hover:bg-[var(--color-gold)] hover:text-ink"
        >
          Проложить маршрут в Яндекс.Картах →
        </a>
        <a
          href={CONTACTS.dgisUrl}
          target="_blank"
          rel="noopener"
          class="plaque inline-flex items-center gap-2 border border-line bg-paper-raised px-5 py-3 font-mono text-[13px] tracking-wide text-ink transition-colors hover:bg-[var(--color-burgundy-soft)]"
        >
          Открыть в 2ГИС →
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-paper-sunk/40 py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-5 md:px-8">
      <FaqSection heading="Частые вопросы" items={faqItems} />
    </div>
  </section>

  <script>
    import { initReveal } from "@/lib/motion";
    import { initInteractiveMaps } from "@/lib/yandexMap";
    initReveal();
    initInteractiveMaps();
  </script>
</Layout>
